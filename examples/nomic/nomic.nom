/// Nomic describing its own reference machine: the ten-stage transition
/// pipeline as a state machine, with the inputs the pipeline reads from a
/// model under test (which rules match and with what disposition, whether
/// effects conflict, which events fire, which invariants fail) supplied by
/// the environment as actions. Every declaration cites the Rust that
/// realizes it, pinned by a content hash of the cited lines; `nomic cite`
/// reports whether those lines have changed since the citation was written.
///
/// One citation is a `contradicts`: the description of `is_legal` states what
/// legality ought to mean, and the cited implementation does not honour it.
///
/// Writing this model found a kernel gap: stage dispatch needs rules that
/// apply only in one stage, and `require` cannot say that because a failed
/// requirement forbids the occurrence. The `when` applicability guard on
/// rules was added for it, realizing the "match against occurrence and
/// current state" wording of the core semantics.
model NomicMachine
  documents "README.md#L226-L240@77de0c9701bc" "the pipeline section of the README"
  realizes "crates/nomic/src/machine.rs#L1-L15@eb1871a676c8" "the module doc lists the ten stages"
  evidences "crates/nomic/tests/examples.rs#L77-L85@eedf5b4d87bc" "tic-tac-toe: 5478 positions, 958 terminal"
  evidences "crates/nomic/tests/examples.rs#L87-L94@c341eb0d5d74" "Connect Four ply counts match OEIS A212693"

/// The pipeline stages, in order. `Idle` is between transitions.
type Stage =
  Idle | Typecheck | Match | Check | Resolve | Transition | Detect | React | Verify | Commit
  realizes "crates/nomic/src/machine.rs#L1-L15@eb1871a676c8"
type Verdict = Accepted | Rejected | ModelError
type Disposition = Allow | Deny | Abstain
  realizes "crates/nomic/src/machine.rs#L79-L86@c506ddec875c"
type RuleId = 1..3
type EventId = 1..3
type InvariantId = 1..2

fact At: Stage
/// Rule `r` matched the occurrence's pattern.
fact Matched(r: RuleId)
  realizes "crates/nomic/src/machine.rs#L442-L461@c05e641f91fc" "match_pattern: bind, wildcard, literal per parameter"
fact Ruled(r: RuleId): Disposition
fact HasEffects(r: RuleId)
/// Two allowing rules disagree about one key in the same round.
fact Conflict
/// The round's effects have been applied to the candidate state.
fact Applied
/// Events detected on an edge and awaiting their reaction round.
fact Pending(e: EventId)
/// Events that have already fired in this transition.
fact Fired(e: EventId)
fact Round: Int
fact Violated(i: InvariantId)
fact Excused(i: InvariantId)
fact Outcome: Verdict

derive any_match: Bool = exists(r: RuleId => Matched(r))
derive any_denial: Bool = exists(r: RuleId => Ruled(r) == Deny)
derive any_pending: Bool = exists(e: EventId => Pending(e))
derive unexcused: Bool = exists(i: InvariantId => Violated(i) && !Excused(i))
derive done: Bool = Outcome != none
/// An occurrence is legal when it would commit. The implementation decides
/// legality from rule dispositions and `ensure` postconditions only, so an
/// action can be legal and still end in a model error at Verify. The cited
/// code contradicts this description; closing the gap flips the relation.
derive is_legal: Bool = any_match && !any_denial
  contradicts "crates/nomic/src/machine.rs#L825-L844@60313ea43af5" "is_legal stops after dispositions and ensures"
/// Reaction rounds are capped so a non-settling cascade is an error, not a hang.
derive max_rounds: Int = 64
  configures "crates/nomic/src/machine.rs#L27@a5b0ef35796c"

/// Start a transition for some occurrence.
action begin
/// The model under test reports that rule `r` matched with disposition `d`.
action rule_matches(r: RuleId, d: Disposition, effects: Bool)
/// Move the pipeline to its next stage.
action advance
/// The model under test reports two rules disagreeing about a key.
action effects_conflict
/// The model under test reports an event whose condition went false to true.
action event_detected(e: EventId)
/// The model under test reports an invariant failing, excused or not.
action invariant_fails(i: InvariantId, excused: Bool)

rule do_begin on begin {
  require At == Idle && !done "a transition is already in progress"
  assert At = Typecheck
  assert Round = 0
}
  realizes "crates/nomic/src/machine.rs#L278-L284@6ec6b409d343" "apply: typecheck the occurrence first"

rule match_only_during_match on rule_matches(r, d, fx) {
  require At == Match "rules are matched only in the Match stage"
}
rule match_once on rule_matches(r, d, fx) {
  require !Matched(r) "a rule matches an occurrence at most once"
}
rule do_match on rule_matches(r, d, fx) when At == Match && !Matched(r) {
  assert Matched(r)
  assert Ruled(r) = d
  if fx && d == Allow { assert HasEffects(r) }
}
  realizes "crates/nomic/src/machine.rs#L401-L440@b5155c272b11" "evaluate_rules: one trace per matched rule; a denied rule's effects are dropped"

rule advance_not_done on advance { deny if done "the transition has ended" }
rule advance_not_idle on advance { require At != Idle "nothing in progress" }
rule to_match on advance when At == Typecheck { assert At = Match }
rule to_check on advance when At == Match { assert At = Check }
rule to_resolve on advance when At == Check { assert At = Resolve }
/// Resolve: no matching rule rejects; any denial rejects; otherwise proceed.
rule resolve_rejects on advance when At == Resolve && (!any_match || any_denial) {
  assert Outcome = Rejected
}
  realizes "crates/nomic/src/machine.rs#L296-L303@cc501716d1d3"
rule resolve_proceeds on advance when At == Resolve && any_match && !any_denial {
  assert At = Transition
}
/// Transition: union the effects and apply them, unless they conflict.
rule apply_effects on advance when At == Transition && !Conflict {
  assert Applied
  assert At = Detect
}
  realizes "crates/nomic/src/machine.rs#L650-L691@59bfffaf4500" "apply_effects: keyed by fact and key tuple"
rule conflict_only_in_transition on effects_conflict {
  require At == Transition && !done "conflicts arise while applying effects"
}
rule do_conflict on effects_conflict when At == Transition {
  assert Conflict
  assert Outcome = ModelError
}
  realizes "crates/nomic/src/machine.rs#L661-L671@65d7f7ffb997" "two effects on one key that differ is MachineError::Conflict"
rule to_react on advance when At == Detect { assert At = React }
/// React: every pending event fires in one round; detection runs again after.
rule reaction_round on advance when At == React && any_pending && Round < max_rounds {
  for (e: EventId where Pending(e)) {
    retract Pending(e)
    assert Fired(e)
  }
  assert Round = (Round ?? 0) + 1
}
  realizes "crates/nomic/src/machine.rs#L323-L380@9d43c76b0e76"
rule reaction_limit on advance when At == React && any_pending && Round >= max_rounds {
  assert Outcome = ModelError
}
  realizes "crates/nomic/src/machine.rs#L328-L331@98dcf1d12ba7"
rule settled on advance when At == React && !any_pending {
  assert At = Verify
}
/// Verify: an unexcused violation is a model error; otherwise commit.
rule verify_fails on advance when At == Verify && unexcused {
  assert Outcome = ModelError
}
  realizes "crates/nomic/src/machine.rs#L382-L392@a4bd1efc0367"
rule do_commit on advance when At == Verify && !unexcused {
  assert At = Commit
  assert Outcome = Accepted
}
  realizes "crates/nomic/src/machine.rs#L394-L397@302162979bd9"

rule detect_only_when_detecting on event_detected(e) {
  require (At == Detect || At == React) && !done "events are detected after effects apply"
}
/// Edge semantics: one event instance fires at most once per transition.
rule once_per_transition on event_detected(e) {
  deny if Fired(e) || Pending(e) "already fired this transition"
}
  realizes "crates/nomic/src/machine.rs#L368-L373@205680706e7f" "the implementation drops the duplicate silently rather than refusing it"
rule do_detect on event_detected(e) when (At == Detect || At == React) && !Fired(e) && !Pending(e) {
  assert Pending(e)
}
  realizes "crates/nomic/src/machine.rs#L694-L732@296cc3982bda" "detect: false in the previous state, true in the new one"

rule fail_only_in_verify on invariant_fails(i, x) {
  require At == Verify && !done "invariants are checked at Verify"
}
rule do_fail on invariant_fails(i, x) when At == Verify {
  assert Violated(i)
  if x { assert Excused(i) }
}
  realizes "crates/nomic/src/machine.rs#L736-L760@9722bdc69159" "verify: exceptions are consulted only for failures"

event TRANSITION_COMMITTED when Outcome == Accepted
event TRANSITION_REJECTED when Outcome == Rejected
event MODEL_DEFECT when Outcome == ModelError

invariant accepted_means_committed: Outcome != Accepted || At == Commit
/// A rejected occurrence changes nothing.
invariant rejected_applies_nothing: Outcome != Rejected || !Applied
  realizes "crates/nomic/src/machine.rs#L296-L303@cc501716d1d3"
invariant nothing_fires_twice: all(e: EventId => !(Fired(e) && Pending(e)))
invariant rounds_bounded: (Round ?? 0) <= max_rounds
invariant excused_implies_violated: all(i: InvariantId where Excused(i) => Violated(i))
invariant conflict_is_fatal: !Conflict || Outcome == ModelError

init { assert At = Idle }

scenario "an accepted transition passes through every stage in order" {
  begin
  expect At == Typecheck
  advance; expect At == Match
  rule_matches(1, Allow, true)
  rule_matches(2, Allow, false)
  advance; expect At == Check
  advance; expect At == Resolve
  advance; expect At == Transition && is_legal
  advance; expect At == Detect && Applied
  advance; expect At == React
  advance; expect At == Verify
  advance emits TRANSITION_COMMITTED
  expect Outcome == Accepted && At == Commit
  advance rejected by advance_not_done
}

scenario "no matching rule rejects" {
  begin; advance; advance; advance
  expect At == Resolve && !any_match
  advance emits TRANSITION_REJECTED
  expect Outcome == Rejected && !Applied
}

scenario "any denial rejects, whatever the other rules say" {
  begin; advance
  rule_matches(1, Allow, true)
  rule_matches(2, Deny, false)
  rule_matches(2, Allow, true) rejected by match_once
  advance; advance
  expect !is_legal
  advance emits TRANSITION_REJECTED
  expect !Applied
}

scenario "conflicting effects are a model error, not a resolution" {
  begin; advance; rule_matches(1, Allow, true); rule_matches(3, Allow, true)
  advance; advance; advance
  expect At == Transition
  effects_conflict emits MODEL_DEFECT
  expect Outcome == ModelError && !Applied
  advance rejected by advance_not_done
}

scenario "reactions cascade in rounds and each event fires once" {
  begin; advance; rule_matches(1, Allow, true); advance; advance; advance; advance
  expect At == Detect
  event_detected(1)
  advance; expect At == React && Round == 0
  advance; expect Fired(1) && !Pending(1) && Round == 1
  event_detected(1) rejected by once_per_transition
  event_detected(2)
  advance; expect Round == 2 && Fired(2)
  advance; expect At == Verify
  advance emits TRANSITION_COMMITTED
}

scenario "an excused invariant failure still commits; an unexcused one is a defect" {
  begin; advance; rule_matches(1, Allow, true); advance; advance; advance; advance; advance; advance
  expect At == Verify
  invariant_fails(1, true)
  advance emits TRANSITION_COMMITTED
  expect Outcome == Accepted
}

scenario "an unexcused invariant failure is a model error" {
  begin; advance; rule_matches(1, Allow, true); advance; advance; advance; advance; advance; advance
  invariant_fails(1, true)
  invariant_fails(2, false)
  advance emits MODEL_DEFECT
  expect Outcome == ModelError && Applied
}

scenario "inputs are only accepted in their stage" {
  rule_matches(1, Allow, true) rejected by match_only_during_match
  event_detected(1) rejected by detect_only_when_detecting
  invariant_fails(1, false) rejected by fail_only_in_verify
  effects_conflict rejected by conflict_only_in_transition
  advance rejected by advance_not_idle
  begin
  begin rejected by do_begin
}
