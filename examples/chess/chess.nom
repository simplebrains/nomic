/// Chess. Files a..h are 0..7 and ranks 1..8 are 0..7, so e4 is (4, 3).
///
/// Everything that makes chess awkward to specify is here: sliding pieces
/// with blocked paths, pawns whose capture geometry differs from their move
/// geometry, en passant, castling with its four preconditions, promotion as a
/// distinct action, and the rule that a move may not leave one's own king
/// attacked. The last is expressed as an `ensure` postcondition rather than a
/// precondition: the machine applies the move's effects, evaluates
/// `king_safe` on the result, and rejects the move if it fails. Checkmate and
/// stalemate then fall out as edge-triggered events over `legal(...)`.
///
/// Not modeled: the fifty-move and threefold-repetition draw claims (the
/// half-move clock is tracked and `FiftyMoves` is announced, but nothing acts
/// on it), draw by agreement, and insufficient material.
model Chess

type Side = White | Black
type Kind = Pawn | Knight | Bishop | Rook | Queen | King
type File = 0..7
type Rank = 0..7
type Wing = Kingside | Queenside
type Result = WhiteWins | BlackWins | Draw

fact Piece(f: File, r: Rank): Kind
fact Color(f: File, r: Rank): Side
fact Turn: Side
/// The side still may castle on this wing (king and that rook unmoved).
fact CastleRight(s: Side, w: Wing)
/// File of the pawn that just advanced two squares; capturable en passant this move only.
fact EnPassant: File
fact Outcome: Result
/// Half-moves since the last capture or pawn move.
fact HalfmoveClock: Int

derive other(s: Side): Side = match s { White => Black, Black => White }
derive forward(s: Side): Int = match s { White => 1, Black => -1 }
derive pawn_rank(s: Side): Int = match s { White => 1, Black => 6 }
derive back_rank(s: Side): Int = match s { White => 0, Black => 7 }
derive last_rank(s: Side): Int = match s { White => 7, Black => 0 }
/// The rank a pawn must stand on to capture en passant.
derive ep_rank(s: Side): Int = match s { White => 4, Black => 3 }
derive abs(x: Int): Int = x < 0 ? -x : x
derive sign(x: Int): Int = x < 0 ? -1 : (x > 0 ? 1 : 0)
derive max(a: Int, b: Int): Int = a > b ? a : b
derive min(a: Int, b: Int): Int = a < b ? a : b
derive on_board(f: Int, r: Int): Bool = f >= 0 && f <= 7 && r >= 0 && r <= 7
derive empty(f: Int, r: Int): Bool = on_board(f, r) && Piece(f, r) == none
derive own(s: Side, f: Int, r: Int): Bool = Color(f, r) == s
derive enemy(s: Side, f: Int, r: Int): Bool = Color(f, r) == other(s)
derive over: Bool = Outcome != none
derive piece_count(s: Side): Int = count(f: File, r: Rank => Color(f, r) == s)

derive steps(f1: Int, r1: Int, f2: Int, r2: Int): Int = max(abs(f2 - f1), abs(r2 - r1))
derive straight(f1: Int, r1: Int, f2: Int, r2: Int): Bool = (f1 == f2) != (r1 == r2)
derive diagonal(f1: Int, r1: Int, f2: Int, r2: Int): Bool = f1 != f2 && abs(f2 - f1) == abs(r2 - r1)
/// Every square strictly between the ends of a straight or diagonal line is empty.
derive clear(f1: Int, r1: Int, f2: Int, r2: Int): Bool =
  all(k: 1..6 where k < steps(f1, r1, f2, r2) =>
    empty(f1 + k * sign(f2 - f1), r1 + k * sign(r2 - r1)))

/// Capture geometry of a piece of kind `k` belonging to `s`, ignoring turn and check.
derive reach(k: Kind, s: Side, f1: Int, r1: Int, f2: Int, r2: Int): Bool =
  match k {
    Pawn => abs(f2 - f1) == 1 && r2 - r1 == forward(s),
    Knight => (abs(f2 - f1) == 1 && abs(r2 - r1) == 2) || (abs(f2 - f1) == 2 && abs(r2 - r1) == 1),
    Bishop => diagonal(f1, r1, f2, r2) && clear(f1, r1, f2, r2),
    Rook => straight(f1, r1, f2, r2) && clear(f1, r1, f2, r2),
    Queen => (straight(f1, r1, f2, r2) || diagonal(f1, r1, f2, r2)) && clear(f1, r1, f2, r2),
    King => steps(f1, r1, f2, r2) == 1
  }
/// Some piece of the opponent of `s` could capture on (f, r).
derive attacked(s: Side, f: Int, r: Int): Bool =
  exists(af: File, ar: Rank where Color(af, ar) == other(s) =>
    reach(Piece(af, ar) ?? Pawn, other(s), af, ar, f, r))
derive king_file(s: Side): Int =
  first(f: File, r: Rank where Piece(f, r) == King && Color(f, r) == s => f) ?? -1
derive king_rank(s: Side): Int =
  first(f: File, r: Rank where Piece(f, r) == King && Color(f, r) == s => r) ?? -1
derive in_check(s: Side): Bool = attacked(s, king_file(s), king_rank(s))

/// A pawn's single push, double push from its home rank, capture, or en passant capture.
derive pawn_move(s: Side, f1: Int, r1: Int, f2: Int, r2: Int): Bool =
  (f1 == f2 && r2 - r1 == forward(s) && empty(f2, r2))
  || (f1 == f2
    && r1 == pawn_rank(s)
    && r2 - r1 == 2 * forward(s)
    && empty(f1, r1 + forward(s))
    && empty(f2, r2))
  || (abs(f2 - f1) == 1
    && r2 - r1 == forward(s)
    && (enemy(s, f2, r2) || (r1 == ep_rank(s) && EnPassant == f2 && empty(f2, r2))))
derive is_en_passant(f1: File, r1: Rank, f2: File, r2: Rank): Bool =
  Piece(f1, r1) == Pawn && f1 != f2 && empty(f2, r2)

/// The piece on (f1, r1) can geometrically go to (f2, r2), ignoring check.
derive movable(f1: File, r1: Rank, f2: File, r2: Rank): Bool =
  Color(f1, r1) != none
  && !(f1 == f2 && r1 == r2)
  && !own(Color(f1, r1) ?? White, f2, r2)
  && (Piece(f1, r1) == Pawn
      ? pawn_move(Color(f1, r1) ?? White, f1, r1, f2, r2)
      : reach(Piece(f1, r1) ?? Pawn, Color(f1, r1) ?? White, f1, r1, f2, r2))

derive rook_file(w: Wing): Int = match w { Kingside => 7, Queenside => 0 }
derive king_to(w: Wing): Int = match w { Kingside => 6, Queenside => 2 }
derive rook_to(w: Wing): Int = match w { Kingside => 5, Queenside => 3 }
derive castle_path_clear(s: Side, w: Wing): Bool =
  all(f: File where f > min(4, rook_file(w)) && f < max(4, rook_file(w)) => empty(f, back_rank(s)))
/// Not castling out of, through, or into check.
derive castle_safe(s: Side, w: Wing): Bool =
  !in_check(s)
  && !attacked(s, (4 + king_to(w)) / 2, back_rank(s))
  && !attacked(s, king_to(w), back_rank(s))

/// Does the side to move have any legal move? Meaningful only for `Turn`,
/// since legality includes whose turn it is.
derive has_legal_move(s: Side): Bool =
  exists(f1: File, r1: Rank where Color(f1, r1) == s =>
      exists(f2: File, r2: Rank where movable(f1, r1, f2, r2) =>
        legal(move(f1, r1, f2, r2)) || legal(promote(f1, r1, f2, r2, Queen))))
  || legal(castle(Kingside))
  || legal(castle(Queenside))

derive home_piece(f: File): Kind =
  match f {
    0 => Rook,
    7 => Rook,
    1 => Knight,
    6 => Knight,
    2 => Bishop,
    5 => Bishop,
    3 => Queen,
    _ => King
  }

/// Move the piece on (f1, r1) to (f2, r2). A pawn reaching the last rank must use Promote.
action move(f1: File, r1: Rank, f2: File, r2: Rank)
action promote(f1: File, r1: Rank, f2: File, r2: Rank, to: Kind)
action castle(wing: Wing)
action resign(side: Side)

rule move_game_over on move(f1, r1, f2, r2) { deny if over "the game is over" }
rule move_own_piece on move(f1, r1, f2, r2) {
  require Color(f1, r1) == Turn "no piece of the side to move there"
}
rule move_geometry on move(f1, r1, f2, r2) {
  require movable(f1, r1, f2, r2) "that piece cannot move there"
}
rule move_must_promote on move(f1, r1, f2, r2) {
  deny if
    Piece(f1, r1) == Pawn && r2 == last_rank(Turn) "a pawn reaching the last rank must promote"
}
rule make_move on move(f1, r1, f2, r2) {
  require Color(f1, r1) == Turn && movable(f1, r1, f2, r2)
  let s = Turn
  let k = Piece(f1, r1) ?? Pawn
  let capture = Piece(f2, r2) != none || is_en_passant(f1, r1, f2, r2)
  retract Piece(f1, r1)
  retract Color(f1, r1)
  assert Piece(f2, r2) = k
  assert Color(f2, r2) = s
  if is_en_passant(f1, r1, f2, r2) {
    retract Piece(f2, r1)
    retract Color(f2, r1)
  }
  if k == Pawn && abs(r2 - r1) == 2 { assert EnPassant = f2 } else { retract EnPassant }
  if k == King {
    retract CastleRight(s, Kingside)
    retract CastleRight(s, Queenside)
  }
  if k == Rook && r1 == back_rank(s) && f1 == 7 { retract CastleRight(s, Kingside) }
  if k == Rook && r1 == back_rank(s) && f1 == 0 { retract CastleRight(s, Queenside) }
  if Piece(f2, r2) == Rook && r2 == back_rank(other(s)) && f2 == 7 {
    retract CastleRight(other(s), Kingside)
  }
  if Piece(f2, r2) == Rook && r2 == back_rank(other(s)) && f2 == 0 {
    retract CastleRight(other(s), Queenside)
  }
  assert HalfmoveClock = capture || k == Pawn ? 0 : (HalfmoveClock ?? 0) + 1
  assert Turn = other(s)
}

rule promote_game_over on promote(f1, r1, f2, r2, to) { deny if over "the game is over" }
rule promote_own_pawn on promote(f1, r1, f2, r2, to) {
  require
    Color(f1, r1) == Turn && Piece(f1, r1) == Pawn "only a pawn of the side to move can promote"
}
rule promote_geometry on promote(f1, r1, f2, r2, to) {
  require movable(f1, r1, f2, r2) && r2 == last_rank(Turn) "the pawn must move onto the last rank"
}
rule promote_piece on promote(f1, r1, f2, r2, to) {
  require
    to == Knight || to == Bishop || to == Rook || to == Queen "promote to a knight, bishop, rook, or queen"
}
rule make_promotion on promote(f1, r1, f2, r2, to) {
  require
    Color(f1, r1) == Turn
    && Piece(f1, r1) == Pawn
    && movable(f1, r1, f2, r2)
    && r2 == last_rank(Turn)
  let s = Turn
  retract Piece(f1, r1)
  retract Color(f1, r1)
  assert Piece(f2, r2) = to
  assert Color(f2, r2) = s
  retract EnPassant
  if Piece(f2, r2) == Rook && f2 == 7 { retract CastleRight(other(s), Kingside) }
  if Piece(f2, r2) == Rook && f2 == 0 { retract CastleRight(other(s), Queenside) }
  assert HalfmoveClock = 0
  assert Turn = other(s)
}

rule castle_game_over on castle(w) { deny if over "the game is over" }
rule castle_rights on castle(w) {
  require CastleRight(Turn, w) "castling rights on that wing are gone"
}
rule castle_pieces on castle(w) {
  require
    Piece(4, back_rank(Turn)) == King
    && Color(4, back_rank(Turn)) == Turn
    && Piece(rook_file(w), back_rank(Turn)) == Rook
    && Color(rook_file(w), back_rank(Turn)) == Turn "king and rook must be on their home squares"
}
rule castle_path on castle(w) {
  require castle_path_clear(Turn, w) "the squares between king and rook must be empty"
}
rule castle_not_through_check on castle(w) {
  require castle_safe(Turn, w) "may not castle out of, through, or into check"
}
rule make_castle on castle(w) {
  require CastleRight(Turn, w) && castle_path_clear(Turn, w)
  let s = Turn
  let r = back_rank(s)
  retract Piece(4, r)
  retract Color(4, r)
  retract Piece(rook_file(w), r)
  retract Color(rook_file(w), r)
  assert Piece(king_to(w), r) = King
  assert Color(king_to(w), r) = s
  assert Piece(rook_to(w), r) = Rook
  assert Color(rook_to(w), r) = s
  retract CastleRight(s, Kingside)
  retract CastleRight(s, Queenside)
  retract EnPassant
  assert HalfmoveClock = (HalfmoveClock ?? 0) + 1
  assert Turn = other(s)
}

rule resign_game_over on resign(s) { deny if over "the game is over" }
rule make_resign on resign(s) { assert Outcome = s == White ? BlackWins : WhiteWins }

/// The side that just moved may not leave its own king attacked.
ensure king_safe: !in_check(other(Turn))

event Check(s: Side) when Turn == s && in_check(s)
event Checkmate(s: Side) when !over && Turn == s && in_check(s) && !has_legal_move(s)
/// Only while the game is in progress: after a resignation no move is legal either.
event Stalemate(s: Side) when !over && Turn == s && !in_check(s) && !has_legal_move(s)
/// Fifty moves without capture or pawn move: a draw may be claimed (not modeled).
event FiftyMoves when (HalfmoveClock ?? 0) >= 100

rule record_checkmate on Checkmate(s) { assert Outcome = s == White ? BlackWins : WhiteWins }
rule record_stalemate on Stalemate(s) { assert Outcome = Draw }

invariant one_king_each:
  count(f: File, r: Rank => Piece(f, r) == King && Color(f, r) == White) == 1
  && count(f: File, r: Rank => Piece(f, r) == King && Color(f, r) == Black) == 1
invariant pieces_have_colors:
  all(f: File, r: Rank => (Piece(f, r) == none) == (Color(f, r) == none))
invariant no_pawns_on_end_ranks: all(f: File => Piece(f, 0) != Pawn && Piece(f, 7) != Pawn)
invariant sixteen_at_most: piece_count(White) <= 16 && piece_count(Black) <= 16
/// The side that just moved is never left in check (the ensure guarantees it).
invariant side_not_to_move_is_safe: !in_check(other(Turn))

init {
  for (f: File, s: Side) {
    assert Piece(f, back_rank(s)) = home_piece(f)
    assert Color(f, back_rank(s)) = s
    assert Piece(f, pawn_rank(s)) = Pawn
    assert Color(f, pawn_rank(s)) = s
  }
  for (s: Side, w: Wing) { assert CastleRight(s, w) }
  assert Turn = White
  assert HalfmoveClock = 0
}

scenario "scholar's mate" {
  move(4, 1, 4, 3); move(4, 6, 4, 4)
  move(3, 0, 7, 4); move(1, 7, 2, 5)
  move(5, 0, 2, 3); move(6, 7, 5, 5)
  move(7, 4, 5, 6) emits Check(Black), Checkmate(Black)
  expect Outcome == WhiteWins && over
  move(4, 7, 3, 6) rejected by move_game_over
}

scenario "a check must be answered and the king may not walk into attack" {
  move(4, 1, 4, 3); move(3, 6, 3, 4)
  move(5, 0, 1, 4) emits Check(Black)
  expect in_check(Black) && Turn == Black
  move(0, 6, 0, 5) rejected by king_safe
  move(1, 7, 2, 5)
  expect !in_check(Black) && Turn == White
}

scenario "the king cannot step into a rook's line" {
  given nothing
  given Turn = White
  given Piece(4, 0) = King; given Color(4, 0) = White
  given Piece(4, 7) = King; given Color(4, 7) = Black
  given Piece(0, 1) = Rook; given Color(0, 1) = Black
  move(4, 0, 4, 1) rejected by king_safe
  move(4, 0, 5, 0)
  expect Piece(5, 0) == King && Turn == Black
}

scenario "castling kingside and its preconditions" {
  move(4, 1, 4, 3); move(4, 6, 4, 4)
  move(6, 0, 5, 2); move(1, 7, 2, 5)
  move(5, 0, 2, 3); move(5, 7, 2, 4)
  expect CastleRight(White, Kingside) && castle_path_clear(White, Kingside)
  castle(Kingside)
  expect Piece(6, 0) == King && Piece(5, 0) == Rook && Piece(4, 0) == none && Piece(7, 0) == none
  expect !CastleRight(White, Kingside) && !CastleRight(White, Queenside)
  castle(Queenside) rejected by castle_path
  castle(Kingside) rejected by castle_path
}

scenario "en passant" {
  move(4, 1, 4, 3); move(0, 6, 0, 5)
  move(4, 3, 4, 4); move(3, 6, 3, 4)
  expect EnPassant == 3
  move(4, 4, 3, 5)
  expect Piece(3, 4) == none && Piece(3, 5) == Pawn && Color(3, 5) == White && EnPassant == none
  expect piece_count(Black) == 15
}

scenario "promotion" {
  given nothing
  given Turn = White
  given Piece(4, 0) = King; given Color(4, 0) = White
  given Piece(4, 7) = King; given Color(4, 7) = Black
  given Piece(0, 6) = Pawn; given Color(0, 6) = White
  move(0, 6, 0, 7) rejected by move_must_promote
  promote(0, 6, 0, 7, King) rejected by promote_piece
  promote(0, 6, 0, 7, Pawn) rejected by promote_piece
  promote(0, 6, 0, 7, Queen) emits Check(Black)
  expect Piece(0, 7) == Queen && Color(0, 7) == White && Turn == Black
}

scenario "stalemate is a draw" {
  given nothing
  given Turn = White
  given Piece(1, 5) = King; given Color(1, 5) = White
  given Piece(2, 0) = Queen; given Color(2, 0) = White
  given Piece(0, 7) = King; given Color(0, 7) = Black
  move(2, 0, 2, 6) emits Stalemate(Black)
  expect Outcome == Draw && !in_check(Black)
}

scenario "resignation ends the game" {
  move(4, 1, 4, 3)
  resign(Black)
  expect Outcome == WhiteWins
  move(4, 6, 4, 4) rejected by move_game_over
}

scenario "pieces obey their geometry" {
  move(0, 0, 0, 2) rejected by move_geometry
  move(1, 0, 3, 1) rejected by move_geometry
  move(1, 0, 2, 2)
  move(4, 6, 4, 4)
  move(2, 2, 4, 3)
  expect Piece(4, 3) == Knight && HalfmoveClock == 1
}
