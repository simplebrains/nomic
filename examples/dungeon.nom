/// A small fantasy role-playing game: a hero, three monsters, five rooms,
/// items on the floor and in packs, a locked treasury, initiative order,
/// combat, death, and an escape with the gold.
///
/// The interesting modeling decision is randomness. The kernel is
/// deterministic, so the die roll is a parameter of the `Attack` action
/// supplied by whoever drives the machine (a player, a test, or an
/// exhaustive explorer that tries every roll). Nondeterminism lives at the
/// boundary; the rules stay pure and every outcome stays explainable.
model DungeonCrawl

type Actor = Hero | Goblin | Orc | Dragon
type Room = Entrance | Hall | Armory | Treasury | Lair
type Item = Sword | Shield | Potion | Key | Gold
type Roll = 1..6

fact Alive(a: Actor)
fact Location(a: Actor): Room
fact HP(a: Actor): Int
fact Carrying(a: Actor, i: Item)
/// Items lying on the floor of a room.
fact ItemAt(i: Item): Room
fact Locked(r: Room)
/// Used up; no longer anywhere.
fact Consumed(i: Item)
/// Whose turn it is. Initiative cycles through living actors in declaration order.
fact Turn: Actor
fact Escaped

derive Adjacent(a: Room, b: Room): Bool =
  match a {
    Entrance => b == Hall,
    Hall => b == Entrance || b == Armory || b == Treasury || b == Lair,
    Armory => b == Hall,
    Treasury => b == Hall,
    Lair => b == Hall
  }
/// Balance values; not tuned against play.
assumed derive MaxHP(a: Actor): Int = match a { Hero => 20, Goblin => 6, Orc => 12, Dragon => 40 }
assumed derive BaseDamage(a: Actor): Int = match a { Hero => 3, Goblin => 2, Orc => 4, Dragon => 8 }
derive Weapon(a: Actor): Int = Carrying(a, Sword) ? 3 : 0
derive Armor(a: Actor): Int = Carrying(a, Shield) ? 2 : 0
derive Max(x: Int, y: Int): Int = x > y ? x : y
derive Min(x: Int, y: Int): Int = x < y ? x : y
/// Damage dealt for a given roll: base plus weapon, roll adjusts by -2..+3, armor absorbs.
derive Damage(attacker: Actor, target: Actor, roll: Roll): Int =
  Max(0, BaseDamage(attacker) + Weapon(attacker) + roll - 3 - Armor(target))
derive Health(a: Actor): Int = HP(a) ?? 0
derive Hostile(a: Actor, b: Actor): Bool = (a == Hero) != (b == Hero)
derive SameRoom(a: Actor, b: Actor): Bool = Location(a) != none && Location(a) == Location(b)
/// Next living actor after `a` in initiative order, wrapping around.
derive Next(a: Actor): Actor =
  first(b: Actor where b > a && Alive(b) => b) ?? (first(b: Actor where b != a && Alive(b) => b) ?? a)
derive GameOver: Bool = Escaped || !Alive(Hero)
derive Holder(i: Item): Actor? = first(a: Actor where Carrying(a, i) => a)

action Move(actor: Actor, to: Room)
/// Attack a hostile in the same room; `roll` is the die, supplied from outside.
action Attack(attacker: Actor, target: Actor, roll: Roll)
action PickUp(actor: Actor, item: Item)
action Drink(actor: Actor)
action Unlock(actor: Actor, room: Room)
action Wait(actor: Actor)

rule MoveTurn on Move(a, to) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule MoveAdjacent on Move(a, to) { require Adjacent(Location(a) ?? Hall, to) "rooms are not connected" }
rule MoveUnlocked on Move(a, to) { require !Locked(to) "the door is locked" }
rule DoMove on Move(a, to) {
  require Turn == a && Alive(a) && Adjacent(Location(a) ?? Hall, to) && !Locked(to)
  assert Location(a) = to
  assert Turn = Next(a)
}

rule AttackTurn on Attack(a, t, roll) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule AttackTarget on Attack(a, t, roll) { require Alive(t) && Hostile(a, t) && SameRoom(a, t) "no such target here" }
rule DoAttack on Attack(a, t, roll) {
  require Turn == a && Alive(a) && Alive(t) && Hostile(a, t) && SameRoom(a, t)
  assert HP(t) = Health(t) - Damage(a, t, roll)
  assert Turn = Next(a)
}

rule PickUpTurn on PickUp(a, i) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule PickUpHere on PickUp(a, i) { require ItemAt(i) != none && ItemAt(i) == Location(a) "the item is not here" }
rule OnlyHeroesLoot on PickUp(a, i) { require a == Hero "monsters do not pick things up" }
rule DoPickUp on PickUp(a, i) {
  require Turn == a && Alive(a) && a == Hero && ItemAt(i) != none && ItemAt(i) == Location(a)
  retract ItemAt(i)
  assert Carrying(a, i)
  assert Turn = Next(a)
}

rule DrinkTurn on Drink(a) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule DrinkHasPotion on Drink(a) { require Carrying(a, Potion) "no potion to drink" }
rule DoDrink on Drink(a) {
  require Turn == a && Alive(a) && Carrying(a, Potion)
  retract Carrying(a, Potion)
  assert Consumed(Potion)
  assert HP(a) = Min(MaxHP(a), Health(a) + 10)
  assert Turn = Next(a)
}

rule UnlockTurn on Unlock(a, r) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule UnlockKey on Unlock(a, r) { require Carrying(a, Key) "no key" }
rule UnlockAdjacent on Unlock(a, r) { require Locked(r) && Adjacent(Location(a) ?? Hall, r) "no locked door to that room from here" }
rule DoUnlock on Unlock(a, r) {
  require Turn == a && Alive(a) && Carrying(a, Key) && Locked(r) && Adjacent(Location(a) ?? Hall, r)
  retract Locked(r)
  assert Turn = Next(a)
}

rule WaitTurn on Wait(a) { require !GameOver && Turn == a && Alive(a) "not this actor's turn" }
rule DoWait on Wait(a) {
  require Turn == a && Alive(a)
  assert Turn = Next(a)
}

/// Hit points reached zero. Reaction: the actor leaves play and drops its pack.
event Died(a: Actor) when Alive(a) && Health(a) <= 0
rule OnDeath on Died(a) {
  retract Alive(a)
  for (i: Item where Carrying(a, i)) {
    retract Carrying(a, i)
    assert ItemAt(i) = Location(a) ?? Hall
  }
  retract Location(a)
  if Turn == a { assert Turn = Next(a) }
}
/// The hero reaches the entrance carrying the gold.
event Victory when Alive(Hero) && Carrying(Hero, Gold) && Location(Hero) == Entrance
rule OnVictory on Victory { assert Escaped }
event Defeat when !Alive(Hero)

invariant LivingHaveRooms: all(a: Actor => Alive(a) == (Location(a) != none))
invariant DeadCarryNothing: all(a: Actor, i: Item where Carrying(a, i) => Alive(a))
invariant HealthBounded: all(a: Actor where Alive(a) => Health(a) >= 1 && Health(a) <= MaxHP(a))
/// Every item is in exactly one place: a room floor, one pack, or consumed.
invariant ItemsInOnePlace:
  all(i: Item => (ItemAt(i) != none ? 1 : 0) + count(a: Actor => Carrying(a, i)) + (Consumed(i) ? 1 : 0) == 1)
invariant TurnIsAlive: !Alive(Hero) || Alive(Turn ?? Hero)

init {
  for (a: Actor) { assert Alive(a); assert HP(a) = MaxHP(a) }
  assert Location(Hero) = Entrance
  assert Location(Goblin) = Hall
  assert Location(Orc) = Armory
  assert Location(Dragon) = Lair
  assert ItemAt(Sword) = Armory
  assert ItemAt(Shield) = Armory
  assert ItemAt(Potion) = Hall
  assert ItemAt(Key) = Lair
  assert ItemAt(Gold) = Treasury
  assert Locked(Treasury)
  assert Turn = Hero
}

scenario "initiative cycles through the living" {
  expect Turn == Hero
  Move(Hero, Hall)
  expect Turn == Goblin
  Wait(Goblin)
  expect Turn == Orc
  Wait(Orc); Wait(Dragon)
  expect Turn == Hero
  Wait(Goblin) rejected by WaitTurn
}

scenario "rooms must connect and locked doors hold" {
  Move(Hero, Lair) rejected by MoveAdjacent
  Move(Hero, Hall)
  Wait(Goblin); Wait(Orc); Wait(Dragon)
  Move(Hero, Treasury) rejected by MoveUnlocked
  Unlock(Hero, Treasury) rejected by UnlockKey
}

scenario "combat with dice, a kill, and dropped loot" {
  Move(Hero, Hall)
  Attack(Goblin, Hero, 6)
  expect Health(Hero) == 15
  Wait(Orc); Wait(Dragon)
  Attack(Hero, Goblin, 1) emits nothing
  expect Health(Goblin) == 5 && Alive(Goblin)
  Attack(Goblin, Hero, 1) emits nothing
  expect Health(Hero) == 15
  Wait(Orc); Wait(Dragon)
  Attack(Hero, Goblin, 6) emits Died(Goblin)
  expect !Alive(Goblin) && Location(Goblin) == none && Turn == Orc
  Attack(Goblin, Hero, 3) rejected by AttackTurn
  Wait(Orc); Wait(Dragon)
  Attack(Hero, Dragon, 6) rejected by AttackTarget
  PickUp(Hero, Potion)
}

scenario "a potion heals but never past the maximum" {
  Move(Hero, Hall)
  Attack(Goblin, Hero, 6)
  Wait(Orc); Wait(Dragon)
  PickUp(Hero, Potion)
  Wait(Goblin); Wait(Orc); Wait(Dragon)
  expect Health(Hero) == 15
  Drink(Hero)
  expect Health(Hero) == 20 && !Carrying(Hero, Potion)
  Wait(Goblin); Wait(Orc); Wait(Dragon)
  Drink(Hero) rejected by DrinkHasPotion
}

scenario "armor and weapons change the damage" {
  given nothing
  given Alive(Hero); given HP(Hero) = 20; given Location(Hero) = Armory
  given Alive(Orc); given HP(Orc) = 12; given Location(Orc) = Armory
  given ItemAt(Sword) = Armory; given ItemAt(Shield) = Armory
  given ItemAt(Potion) = Hall; given ItemAt(Key) = Lair; given ItemAt(Gold) = Treasury
  given Turn = Hero
  PickUp(Hero, Sword)
  Attack(Orc, Hero, 3)
  expect Health(Hero) == 16
  PickUp(Hero, Shield)
  Attack(Orc, Hero, 3)
  expect Health(Hero) == 14
  Attack(Hero, Orc, 3)
  expect Health(Orc) == 6
}

scenario "the dragon can kill the hero, which ends the game" {
  given nothing
  given Alive(Hero); given HP(Hero) = 5; given Location(Hero) = Lair
  given Alive(Dragon); given HP(Dragon) = 40; given Location(Dragon) = Lair
  given ItemAt(Sword) = Armory; given ItemAt(Shield) = Armory
  given ItemAt(Potion) = Hall; given ItemAt(Key) = Lair; given ItemAt(Gold) = Treasury
  given Turn = Dragon
  Attack(Dragon, Hero, 4) emits Died(Hero), Defeat
  expect !Alive(Hero) && GameOver && Turn == Dragon
  Wait(Dragon) rejected by WaitTurn
}

scenario "escaping with the gold is victory" {
  given nothing
  given Alive(Hero); given HP(Hero) = 20; given Location(Hero) = Hall
  given Carrying(Hero, Key)
  given ItemAt(Sword) = Armory; given ItemAt(Shield) = Armory; given ItemAt(Potion) = Hall
  given ItemAt(Gold) = Treasury
  given Locked(Treasury)
  given Turn = Hero
  Unlock(Hero, Treasury)
  Move(Hero, Treasury)
  PickUp(Hero, Gold)
  Move(Hero, Hall)
  Move(Hero, Entrance) emits Victory
  expect Escaped && GameOver
  Move(Hero, Hall) rejected by MoveTurn
}
