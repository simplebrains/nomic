/// Tic-tac-toe on a 3x3 grid. Small enough for exhaustive exploration of the
/// entire game tree, which makes it the first model to verify completely.
model TicTacToe

type Mark = X | O
type Pos = 0..2

/// The mark at (col, row), if any.
fact Cell(col: Pos, row: Pos): Mark
fact Turn: Mark
fact Winner: Mark
fact Drawn

derive Other(m: Mark): Mark = match m { X => O, O => X }
derive Marks(m: Mark): Int = count(c: Pos, r: Pos => Cell(c, r) == m)
derive Filled: Int = count(c: Pos, r: Pos => Cell(c, r) != none)
derive Row(m: Mark, r: Pos): Bool = all(c: Pos => Cell(c, r) == m)
derive Col(m: Mark, c: Pos): Bool = all(r: Pos => Cell(c, r) == m)
derive Diag(m: Mark): Bool = all(i: Pos => Cell(i, i) == m) || all(i: Pos => Cell(i, 2 - i) == m)
derive Wins(m: Mark): Bool = exists(i: Pos => Row(m, i) || Col(m, i)) || Diag(m)
derive Over: Bool = Winner != none || Drawn

action Play(mark: Mark, col: Pos, row: Pos)

rule GameOver on Play(m, c, r) {
  deny if Over "the game is over"
}
rule TurnOrder on Play(m, c, r) {
  require Turn == m "not your turn"
}
rule Place on Play(m, c, r) {
  require Cell(c, r) == none "square is taken"
  assert Cell(c, r) = m
  assert Turn = Other(m)
}

event Win(m: Mark) when Wins(m)
event Draw when Filled == 9 && !Wins(X) && !Wins(O)

rule RecordWinner on Win(m) { assert Winner = m }
rule RecordDraw on Draw { assert Drawn }

invariant TurnMatchesMarks: Turn == X ? Marks(X) == Marks(O) : Marks(X) == Marks(O) + 1
invariant OneWinner: !(Wins(X) && Wins(O))
invariant WinnerWins: Winner == none || Wins(Winner)
invariant DrawIsFull: !Drawn || Filled == 9

init { assert Turn = X }

scenario "X wins the first column" {
  Play(X, 0, 0); Play(O, 1, 0); Play(X, 0, 1); Play(O, 1, 1)
  Play(X, 0, 2) emits Win(X)
  expect Winner == X
  Play(O, 2, 2) rejected by GameOver
}

scenario "a drawn game" {
  Play(X, 0, 0); Play(O, 1, 1); Play(X, 2, 2); Play(O, 0, 1); Play(X, 2, 1)
  Play(O, 2, 0); Play(X, 0, 2); Play(O, 1, 2)
  Play(X, 1, 0) emits Draw
  expect Drawn && Winner == none
}

scenario "taken squares and wrong turns are rejected" {
  Play(O, 0, 0) rejected by TurnOrder
  Play(X, 0, 0)
  Play(O, 0, 0) rejected by Place
}
