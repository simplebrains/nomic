/// American checkers (draughts) on an 8x8 board, twelve men a side.
/// Men step diagonally forward; kings step diagonally in any direction.
/// Captures jump over an adjacent enemy to the empty square beyond, are
/// mandatory when available, and continue with the same piece while further
/// jumps exist. Reaching the far rank crowns the piece and ends its turn.
/// A side with no pieces or no legal move loses.
///
/// This model exercises the reaction mechanism: a jump does not end the turn
/// itself. The `JUMP_ENDED` event fires when the landing square offers no
/// further capture (or the piece was just crowned), and its reaction rule
/// hands the turn over — all inside the one transition.
model Checkers

type Side = Red | Black
type File = 0..7
type Rank = 0..7
type Dir = -1..1

/// The side owning the piece on a square, if any.
fact Owner(f: File, r: Rank): Side
/// The piece on this square is a king.
fact King(f: File, r: Rank)
fact Turn: Side
/// A piece in mid-capture that must keep jumping from here.
fact Continuing(f: File, r: Rank)
/// The continuing piece was crowned by its last jump, which ends the turn.
fact Crowned(f: File, r: Rank)
fact Winner: Side

derive other(s: Side): Side = match s { Red => Black, Black => Red }
/// Red moves up the board, Black down.
derive forward(s: Side): Int = match s { Red => 1, Black => -1 }
derive crown_rank(s: Side): Int = match s { Red => 7, Black => 0 }
/// Pieces live on the dark squares only.
derive dark(f: Int, r: Int): Bool = (f + r) % 2 == 1
derive on_board(f: Int, r: Int): Bool = f >= 0 && f <= 7 && r >= 0 && r <= 7
derive empty(f: Int, r: Int): Bool = on_board(f, r) && Owner(f, r) == none
derive pieces(s: Side): Int = count(f: File, r: Rank => Owner(f, r) == s)
derive kings(s: Side): Int = count(f: File, r: Rank => Owner(f, r) == s && King(f, r))

/// The piece at (f, r) may move in direction (df, dr): diagonal, and forward
/// unless it is a king.
derive heading(f: File, r: Rank, df: Dir, dr: Dir): Bool =
  Owner(f, r) != none && df != 0 && dr != 0 && (King(f, r) || dr == forward(Owner(f, r) ?? Red))
derive step_ok(f: File, r: Rank, df: Dir, dr: Dir): Bool =
  heading(f, r, df, dr) && empty(f + df, r + dr)
derive jump_ok(f: File, r: Rank, df: Dir, dr: Dir): Bool =
  heading(f, r, df, dr)
  && Owner(f + df, r + dr) == other(Owner(f, r) ?? Red)
  && empty(f + 2 * df, r + 2 * dr)
derive can_jump(f: File, r: Rank): Bool = exists(df: Dir, dr: Dir => jump_ok(f, r, df, dr))
derive can_step(f: File, r: Rank): Bool = exists(df: Dir, dr: Dir => step_ok(f, r, df, dr))
derive side_can_jump(s: Side): Bool =
  exists(f: File, r: Rank where Owner(f, r) == s => can_jump(f, r))
derive has_move(s: Side): Bool =
  exists(f: File, r: Rank where Owner(f, r) == s => can_jump(f, r) || can_step(f, r))
derive mid_capture: Bool = exists(f: File, r: Rank => Continuing(f, r))
derive over: Bool = Winner != none

/// Move the piece at (f, r) one square in direction (df, dr).
action step(side: Side, f: File, r: Rank, df: Dir, dr: Dir)
/// Jump the piece at (f, r) over the adjacent enemy in direction (df, dr).
action jump(side: Side, f: File, r: Rank, df: Dir, dr: Dir)

rule step_game_over on step(s, f, r, df, dr) { deny if over "the game is over" }
rule step_turn on step(s, f, r, df, dr) { require Turn == s "not your turn" }
rule step_own_piece on step(s, f, r, df, dr) { require Owner(f, r) == s "not your piece" }
rule step_not_mid_capture on step(s, f, r, df, dr) {
  deny if mid_capture "a capture in progress must be completed"
}
rule capture_is_mandatory on step(s, f, r, df, dr) {
  deny if side_can_jump(s) "a capture is available and must be taken"
}
rule make_step on step(s, f, r, df, dr) {
  require step_ok(f, r, df, dr) "illegal step"
  retract Owner(f, r)
  assert Owner(f + df, r + dr) = s
  if King(f, r) {
    retract King(f, r)
    assert King(f + df, r + dr)
  } else if r + dr == crown_rank(s) {
    assert King(f + df, r + dr)
  }
  assert Turn = other(s)
}

rule jump_game_over on jump(s, f, r, df, dr) { deny if over "the game is over" }
rule jump_turn on jump(s, f, r, df, dr) { require Turn == s "not your turn" }
rule jump_own_piece on jump(s, f, r, df, dr) { require Owner(f, r) == s "not your piece" }
rule jump_same_piece on jump(s, f, r, df, dr) {
  deny if mid_capture && !Continuing(f, r) "the capture must continue with the same piece"
}
rule make_jump on jump(s, f, r, df, dr) {
  require jump_ok(f, r, df, dr) "illegal jump"
  let tf = f + 2 * df
  let tr = r + 2 * dr
  retract Owner(f, r)
  retract Owner(f + df, r + dr)
  retract King(f + df, r + dr)
  assert Owner(tf, tr) = s
  if King(f, r) {
    retract King(f, r)
    assert King(tf, tr)
  } else if tr == crown_rank(s) {
    assert King(tf, tr)
    assert Crowned(tf, tr)
  }
  retract Continuing(f, r)
  assert Continuing(tf, tr)
}

/// The jumping piece can go no further (or was just crowned): its turn ends.
event JUMP_ENDED(f: File, r: Rank) when Continuing(f, r) && (Crowned(f, r) || !can_jump(f, r))
rule end_turn on JUMP_ENDED(f, r) {
  retract Continuing(f, r)
  retract Crowned(f, r)
  assert Turn = other(Owner(f, r) ?? Red)
}

/// The side to move has nothing left or nothing legal: the other side wins.
event WON(s: Side) when
  Turn == other(s) && !mid_capture && (pieces(other(s)) == 0 || !has_move(other(s)))
rule record_win on WON(s) { assert Winner = s }

invariant pieces_on_dark_squares: all(f: File, r: Rank where Owner(f, r) != none => dark(f, r))
invariant kings_have_owners: all(f: File, r: Rank where King(f, r) => Owner(f, r) != none)
invariant twelve_at_most: pieces(Red) <= 12 && pieces(Black) <= 12
invariant one_continuing_piece: count(f: File, r: Rank => Continuing(f, r)) <= 1
invariant continuing_piece_is_on_turn:
  all(f: File, r: Rank where Continuing(f, r) => Owner(f, r) == Turn)
invariant crowned_only_while_continuing:
  all(f: File, r: Rank where Crowned(f, r) => Continuing(f, r))

init {
  for (f: File, r: 0..2 where dark(f, r)) { assert Owner(f, r) = Red }
  for (f: File, r: 5..7 where dark(f, r)) { assert Owner(f, r) = Black }
  assert Turn = Red
}

scenario "opening steps alternate turns" {
  expect pieces(Red) == 12 && pieces(Black) == 12
  step(Red, 1, 2, 1, 1)
  expect Owner(2, 3) == Red && Owner(1, 2) == none && Turn == Black
  step(Black, 4, 5, -1, -1)
  expect Owner(3, 4) == Black && Turn == Red
  step(Red, 3, 2, 1, 1) rejected by capture_is_mandatory
}

scenario "a single jump captures and hands over the turn" {
  step(Red, 1, 2, 1, 1)
  step(Black, 4, 5, -1, -1)
  jump(Red, 2, 3, 1, 1) emits JUMP_ENDED(4, 5)
  expect Owner(4, 5) == Red && Owner(3, 4) == none && Owner(2, 3) == none
  expect pieces(Black) == 11 && Turn == Black && !mid_capture
}

scenario "men only move forward and only onto empty dark squares" {
  step(Red, 1, 2, 1, -1) rejected by make_step
  step(Red, 1, 2, 0, 1) rejected by make_step
  step(Red, 0, 1, 1, 1) rejected by make_step
  step(Black, 4, 5, -1, -1) rejected by step_turn
  step(Red, 4, 5, -1, -1) rejected by step_own_piece
}

scenario "a double jump continues within the turn" {
  given nothing
  given Turn = Red
  given Owner(1, 0) = Red
  given Owner(7, 0) = Red
  given Owner(2, 1) = Black
  given Owner(4, 3) = Black
  given Owner(6, 1) = Black
  step(Red, 1, 0, 1, 1) rejected by capture_is_mandatory
  jump(Red, 1, 0, 1, 1) emits nothing
  expect Owner(3, 2) == Red && Owner(2, 1) == none && Turn == Red && mid_capture
  jump(Red, 7, 0, -1, 1) rejected by jump_same_piece
  step(Red, 3, 2, -1, 1) rejected by step_not_mid_capture
  jump(Red, 3, 2, 1, 1) emits JUMP_ENDED(5, 4)
  expect Owner(5, 4) == Red && pieces(Black) == 1 && Turn == Black && !mid_capture
}

scenario "crowning ends the turn even if another jump exists" {
  given nothing
  given Turn = Red
  given Owner(2, 5) = Red
  given Owner(3, 6) = Black
  given Owner(5, 6) = Black
  jump(Red, 2, 5, 1, 1) emits JUMP_ENDED(4, 7)
  expect King(4, 7) && Turn == Black && !mid_capture && !Crowned(4, 7)
  expect can_jump(4, 7)
}

scenario "kings move backward" {
  given nothing
  given Turn = Black
  given Owner(3, 4) = Black
  given King(3, 4)
  given Owner(1, 0) = Red
  step(Black, 3, 4, 1, 1)
  expect Owner(4, 5) == Black && King(4, 5) && !King(3, 4) && Turn == Red
}

scenario "capturing the last piece wins" {
  given nothing
  given Turn = Red
  given Owner(2, 3) = Red
  given Owner(3, 4) = Black
  jump(Red, 2, 3, 1, 1) emits JUMP_ENDED(4, 5), WON(Red)
  expect Winner == Red && pieces(Black) == 0
  step(Red, 4, 5, 1, 1) rejected by step_game_over
}

scenario "a side with no legal move has lost" {
  given nothing
  given Turn = Red
  given Owner(1, 0) = Red
  given Owner(0, 1) = Black
  given Owner(2, 1) = Black
  given Owner(3, 2) = Black
  step(Red, 1, 0, 1, 1) rejected by make_step
  expect !has_move(Red) && has_move(Black)
}
