/// A to-do service: the model behind an MCP-style task tool. Task identities
/// come from outside as UUIDs or database keys; the lifecycle is a partial
/// order; and every constraint ranges over the tasks that exist rather than
/// over any enumerable domain.
///
/// Three Core constructs carry the whole model. `type TaskId = opaque` admits
/// identities the machine can store and compare but never enumerate. `order
/// Status` declares the lifecycle as chains whose transitive closure is the
/// order, so Done and Cancelled are incomparable and "only move forward" is a
/// single `<`. Population binders (`t in Task`, `(t, b) in Blocked`) quantify
/// over a fact's current keys, which is how cardinality, uniqueness, and
/// "no blocker remains" are stated without materializing any collection.
model Todo

type TaskId = opaque
type Status = Draft | Ready | Doing | Done | Cancelled
/// The lifecycle. Cancelled follows Ready or Doing but is unrelated to Done:
/// neither is later than the other, so neither can move to the other.
order Status: Draft < Ready < Doing < Done, Ready < Cancelled, Doing < Cancelled
type Level = Low | Normal | High
type Limit = 1..5

fact Task(id: TaskId): Status
fact Priority(id: TaskId): Level
/// `id` cannot start until `by` is finished or cancelled.
fact Blocked(id: TaskId, by: TaskId)
fact Parent(id: TaskId): TaskId
/// How many tasks may be in Doing at once.
fact WipLimit: Int

derive task_exists(id: TaskId): Bool = Task(id) != none
derive terminal(s: Status): Bool = s == Done || s == Cancelled
derive open(id: TaskId): Bool = Task(id) != none && !terminal(Task(id) ?? Done)
derive in_progress: Int = count(t in Task => Task(t) == Doing)
/// Open tasks still blocking `id`.
derive blockers(id: TaskId): Int = count((t, b) in Blocked where t == id => open(b))
derive wip: Int = WipLimit ?? 1

action create(id: TaskId, level: Level)
/// Move a task forward along the lifecycle order.
action advance(id: TaskId, to: Status)
action cancel(id: TaskId)
action block(id: TaskId, by: TaskId)
action unblock(id: TaskId, by: TaskId)
action nest(child: TaskId, parent: TaskId)
action setWipLimit(n: Limit)

rule create_fresh on create(id, l) { require Task(id) == none "that task id is already in use" }
rule do_create on create(id, l) when Task(id) == none {
  assert Task(id) = Draft
  assert Priority(id) = l
}

rule advance_exists on advance(id, to) { require task_exists(id) "no such task" }
rule advance_forward on advance(id, to) {
  require (Task(id) ?? Done) < to "a task only moves forward in its lifecycle"
}
rule advance_not_cancel on advance(id, to) { require to != Cancelled "use Cancel to cancel" }
rule not_blocked on advance(id, to) {
  require to != Doing || blockers(id) == 0 "blocked by an open task"
}
rule within_wip on advance(id, to) {
  require to != Doing || in_progress < wip "work-in-progress limit reached"
}
rule do_advance on advance(id, to) when task_exists(id) && (Task(id) ?? Done) < to {
  assert Task(id) = to
}

rule cancel_open on cancel(id) { require open(id) "only an open task can be cancelled" }
rule do_cancel on cancel(id) when open(id) {
  assert Task(id) = Cancelled
  for ((t, b) in Blocked where t == id) { retract Blocked(t, b) }
}

rule block_tasks on block(id, by) {
  require task_exists(id) && task_exists(by) && id != by "both must be distinct existing tasks"
}
rule block_open on block(id, by) {
  require open(id) && open(by) "only open tasks take part in blocking"
}
rule do_block on block(id, by) when open(id) && open(by) && id != by { assert Blocked(id, by) }
rule do_unblock on unblock(id, by) {
  require Blocked(id, by) "not blocked by that task"
  retract Blocked(id, by)
}

rule nest_tasks on nest(c, p) {
  require task_exists(c) && task_exists(p) && c != p "both must be distinct existing tasks"
}
rule nest_acyclic on nest(c, p) { require Parent(p) != c "that would make each the other's parent" }
rule do_nest on nest(c, p) when task_exists(c) && task_exists(p) && c != p && Parent(p) != c {
  assert Parent(c) = p
}

rule do_set_wip on setWipLimit(n) {
  require n >= in_progress "lower the work in progress first"
  assert WipLimit = n
}

/// Announced for each task the moment it enters Doing; the population of
/// identities in the state is what the detector ranges over.
event STARTED(id: TaskId) when Task(id) == Doing
event FINISHED(id: TaskId) when Task(id) == Done
/// Every blocker of `id` has ended, while some blocking record still exists.
event UNBLOCKED(id: TaskId) when
  open(id) && blockers(id) == 0 && exists((t, b) in Blocked => t == id)

/// A finished task releases everything it was blocking.
rule release_blocked on FINISHED(id) {
  for ((t, b) in Blocked where b == id) { retract Blocked(t, b) }
}

/// At most one task per priority level may be in progress.
ensure one_per_level_in_progress: unique(t in Task where Task(t) == Doing => Priority(t))

invariant wip_respected: in_progress <= wip
invariant every_task_has_priority: all(t in Task => Priority(t) != none)
invariant priority_only_for_tasks: all(t in Priority => Task(t) != none)
invariant blockers_are_tasks: all((t, b) in Blocked => task_exists(t) && task_exists(b) && t != b)
invariant terminal_tasks_hold_no_blockers: none((t, b) in Blocked => terminal(Task(t) ?? Done))
invariant parents_are_tasks: all(c in Parent => task_exists(c) && task_exists(Parent(c) ?? c))
invariant no_self_parent: none(c in Parent => Parent(c) == c)

init { assert WipLimit = 2 }

scenario "a task moves forward through its lifecycle, never backward" {
  create(TaskId("write-spec"), High)
  expect Task(TaskId("write-spec")) == Draft && count(t in Task => true) == 1
  advance(TaskId("write-spec"), Ready)
  advance(TaskId("write-spec"), Draft) rejected by advance_forward
  advance(TaskId("write-spec"), Doing) emits STARTED(TaskId("write-spec"))
  advance(TaskId("write-spec"), Done) emits FINISHED(TaskId("write-spec"))
  advance(TaskId("write-spec"), Cancelled) rejected by advance_forward
}

scenario "done and cancelled are incomparable" {
  create(TaskId("a"), Normal)
  advance(TaskId("a"), Ready)
  cancel(TaskId("a"))
  advance(TaskId("a"), Done) rejected by advance_forward
  expect !((Task(TaskId("a")) ?? Draft) < Done) && !(Done < (Task(TaskId("a")) ?? Draft))
  expect Cancelled > Ready && Cancelled > Draft && !(Cancelled < Done) && !(Done < Cancelled)
  cancel(TaskId("a")) rejected by cancel_open
}

scenario "identities compare by representation and are never enumerated" {
  create(TaskId("x"), Low)
  create(TaskId("x"), High) rejected by create_fresh
  expect TaskId("x") == TaskId("x") && TaskId("x") != TaskId("y") && task_exists(TaskId("x")) && !task_exists(TaskId("y"))
  advance(TaskId("y"), Ready) rejected by advance_exists
}

scenario "work in progress is limited and the limit is a fact" {
  create(TaskId("a"), Low); create(TaskId("b"), Normal); create(TaskId("c"), High)
  advance(TaskId("a"), Ready); advance(TaskId("b"), Ready); advance(TaskId("c"), Ready)
  advance(TaskId("a"), Doing); advance(TaskId("b"), Doing)
  advance(TaskId("c"), Doing) rejected by within_wip
  setWipLimit(1) rejected by do_set_wip
  setWipLimit(3)
  advance(TaskId("c"), Doing)
  expect in_progress == 3
}

scenario "at most one task per priority level in progress" {
  create(TaskId("a"), High); create(TaskId("b"), High)
  advance(TaskId("a"), Ready); advance(TaskId("b"), Ready)
  advance(TaskId("a"), Doing)
  advance(TaskId("b"), Doing) rejected by one_per_level_in_progress
}

scenario "blocked tasks wait; finishing the blocker releases them" {
  create(TaskId("deploy"), High); create(TaskId("review"), Normal)
  block(TaskId("deploy"), TaskId("review"))
  block(TaskId("deploy"), TaskId("deploy")) rejected by block_tasks
  advance(TaskId("deploy"), Ready)
  advance(TaskId("deploy"), Doing) rejected by not_blocked
  advance(TaskId("review"), Ready); advance(TaskId("review"), Doing)
  advance(TaskId("review"), Done) emits FINISHED(TaskId("review")), UNBLOCKED(TaskId("deploy"))
  expect blockers(TaskId("deploy")) == 0 && none((t, b) in Blocked => true)
  advance(TaskId("deploy"), Doing) emits STARTED(TaskId("deploy"))
}

scenario "cancelling a blocked task drops its blocking records" {
  create(TaskId("a"), Low); create(TaskId("b"), Low)
  block(TaskId("a"), TaskId("b"))
  advance(TaskId("a"), Ready)
  cancel(TaskId("a"))
  expect none((t, b) in Blocked => true) && Task(TaskId("a")) == Cancelled
}

scenario "subtasks nest without two-cycles" {
  create(TaskId("epic"), High); create(TaskId("story"), Normal)
  nest(TaskId("story"), TaskId("epic"))
  nest(TaskId("epic"), TaskId("story")) rejected by nest_acyclic
  expect Parent(TaskId("story")) == TaskId("epic") && all(c in Parent => task_exists(c))
}
