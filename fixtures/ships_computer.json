      ],
      "final_state": [
        "AlertStatus = Red",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "Destroyed",
        "HullIntegrity = 0",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    }
  ]
