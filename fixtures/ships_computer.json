        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 3"
      ]
    },
    {
      "scenario": "self-destruct needs two senior officers and only the captain cancels",
      "steps": [
        {
          "description": "authorize_self_destruct(Ensign) rejected by \"destruct authority\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "destruct authority",
            "do authorize"
          ]
        },
        {
          "description": "authorize_self_destruct(Captain) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "authorize_self_destruct(Captain) rejected by \"destruct once\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "destruct once",
            "do authorize"
          ]
        },
        {
          "description": "tick rejected by \"do tick\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do tick"
          ]
        },
        {
          "description": "authorize_self_destruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SELF_DESTRUCT_ARMED"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "cancel_self_destruct(FirstOfficer) rejected by \"cancel is captains\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "cancel is captains",
            "do cancel"
          ]
        },
        {
          "description": "cancel_self_destruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Countdown",
            "retract SelfDestructArmedBy(Captain)",
            "retract SelfDestructArmedBy(ChiefEngineer)",
            "retract SelfDestructArmedBy(Doctor)",
            "retract SelfDestructArmedBy(Ensign)",
            "retract SelfDestructArmedBy(FirstOfficer)"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "detonation",
      "steps": [
        {
          "description": "authorize_self_destruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "authorize_self_destruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SELF_DESTRUCT_ARMED"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "tick accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "DETONATION"
          ],
          "effects": [
            "assert Countdown = 0",
            "assert Destroyed"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "set_alert(Captain, Green) rejected by \"alert command\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "alert command"
          ]
        },
        {
          "description": "tick rejected by \"do tick\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do tick"
          ]
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "Countdown = 0",
        "Destroyed",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "SelfDestructArmedBy(Captain)",
        "SelfDestructArmedBy(FirstOfficer)",
        "TorpedoCount = 4"
      ]
    },
    {
