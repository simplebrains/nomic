{
  "nomic_core": "0.1",
  "model": "ShipsComputer",
  "cases": [
    {
      "scenario": "chain of command",
      "steps": [
        {
          "description": "set_alert(Ensign, Red) rejected by \"alert command\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "alert command",
            "do set alert"
          ]
        },
        {
          "description": "set_alert(Doctor, Red) rejected by \"alert command\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "alert command",
            "do set alert"
          ]
        },
        {
          "description": "set_alert(FirstOfficer, Yellow) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert AlertStatus = Yellow"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "allocate_power(Ensign, Sensors, 0) rejected by \"power authority\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "power authority",
            "do allocate"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Sensors, 0) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Sensors) = 0"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Yellow",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 0",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "the power budget is a hard limit, except for the observed red-alert overdraw",
      "steps": [
        {
          "description": "allocate_power(ChiefEngineer, Phasers, 2) rejected by \"power budget\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "power budget"
          ]
        },
        {
          "description": "set_alert(Captain, Red) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert AlertStatus = Red"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Phasers, 2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Phasers) = 2"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "allocate_power(ChiefEngineer, Torpedoes, 2) rejected by \"power budget\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "power budget"
          ]
        },
        {
          "description": "set_alert(Captain, Green) rejected by \"stand down within budget\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "stand down within budget"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Phasers, 0) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Phasers) = 0"
          ]
        },
        {
          "description": "set_alert(Captain, Green) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert AlertStatus = Green"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Phasers) = 0",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "shields absorb fire and a breach raises the alarm",
      "steps": [
        {
          "description": "raise_shields(Ensign) rejected by \"shields command\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "shields command",
            "do raise"
          ]
        },
        {
          "description": "raise_shields(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert ShieldsUp"
          ]
        },
        {
          "description": "take_hit(20) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HullIntegrity = 89"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "lower_shields(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract ShieldsUp"
          ]
        },
        {
          "description": "take_hit(20) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HullIntegrity = 69"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "take_hit(40) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "HULL_BREACH"
          ],
          "effects": [
            "assert HullIntegrity = 29",
            "assert AlertStatus = Red"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Red",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 29",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "reallocation may not starve raised shields or life support",
      "steps": [
        {
          "description": "raise_shields(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert ShieldsUp"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Shields, 1) rejected by \"shields stay powered\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "shields stay powered"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, LifeSupport, 1) rejected by \"life support minimum\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "life support minimum"
          ]
        },
        {
          "description": "lower_shields(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract ShieldsUp"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Shields, 1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Shields) = 1"
          ]
        },
        {
          "description": "raise_shields(Captain) rejected by \"shields operational\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "shields operational",
            "do raise"
          ]
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 1",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "damage reports and repairs",
      "steps": [
        {
          "description": "report_damage(Shields) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Damaged(Shields) = true"
          ]
        },
        {
          "description": "report_damage(Shields) rejected by \"do report damage\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do report damage"
          ]
        },
        {
          "description": "raise_shields(Captain) rejected by \"shields operational\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "shields operational",
            "do raise"
          ]
        },
        {
          "description": "repair(Ensign, Shields) rejected by \"repair authority\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "repair authority",
            "do repair"
          ]
        },
        {
          "description": "repair(ChiefEngineer, Shields) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Damaged(Shields)"
          ]
        },
        {
          "description": "repair(ChiefEngineer, Shields) rejected by \"repair needed\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "repair needed",
            "do repair"
          ]
        },
        {
          "description": "raise_shields(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert ShieldsUp"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "ShieldsUp",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "warp needs coils powered for the factor",
      "steps": [
        {
          "description": "engage_warp(Captain, 5) rejected by \"warp power\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "warp power",
            "do warp"
          ]
        },
        {
          "description": "engage_warp(Captain, 4) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert WarpSpeed = 4"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "allocate_power(ChiefEngineer, Warp, 2) rejected by \"warp needs power\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "warp needs power"
          ]
        },
        {
          "description": "all_stop(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract WarpSpeed"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Warp, 2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Warp) = 2"
          ]
        },
        {
          "description": "engage_warp(Captain, 2) rejected by \"warp operational\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "warp operational",
            "do warp"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Warp, 5) rejected by \"power budget\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "power budget"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Sensors, 0) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Sensors) = 0"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Warp, 5) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Warp) = 5"
          ]
        },
        {
          "description": "engage_warp(Captain, 5) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert WarpSpeed = 5"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 0",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 5",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4",
        "WarpSpeed = 5"
      ]
    },
    {
      "scenario": "weapons are locked outside red alert",
      "steps": [
        {
          "description": "fire_torpedo(Captain) rejected by \"torpedo red alert\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "torpedo red alert",
            "do fire torpedo"
          ]
        },
        {
          "description": "set_alert(Captain, Red) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert AlertStatus = Red"
          ]
        },
        {
          "description": "fire_torpedo(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert TorpedoCount = 3"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "fire_phasers(Captain) rejected by \"phaser ready\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
