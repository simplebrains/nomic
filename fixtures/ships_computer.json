          ]
        },
        {
          "description": "AllocatePower(ChiefEngineer, Warp, 5) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Warp) = 5"
          ]
        },
        {
          "description": "EngageWarp(Captain, 5) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert WarpSpeed = 5"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 0",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 5",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "TorpedoCount = 4",
        "WarpSpeed = 5"
      ]
    },
    {
      "scenario": "weapons are locked outside red alert",
      "steps": [
        {
          "description": "FireTorpedo(Captain) rejected by TorpedoRedAlert",
          "passed": true,
          "accepted": false,
