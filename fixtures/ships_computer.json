    {
      "scenario": "self-destruct needs two senior officers and only the captain cancels",
      "steps": [
        {
          "description": "authorize_self_destruct(Ensign) rejected by destruct_authority",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "destruct_authority",
            "do_authorize"
          ]
        },
        {
          "description": "authorize_self_destruct(Captain) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "authorize_self_destruct(Captain) rejected by destruct_once",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "destruct_once",
            "do_authorize"
          ]
        },
        {
          "description": "tick rejected by do_tick",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do_tick"
          ]
        },
        {
          "description": "authorize_self_destruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SELF_DESTRUCT_ARMED"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "cancel_self_destruct(FirstOfficer) rejected by cancel_is_captains",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "cancel_is_captains",
            "do_cancel"
          ]
        },
        {
          "description": "cancel_self_destruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Countdown",
            "retract SelfDestructArmedBy(Captain)",
            "retract SelfDestructArmedBy(ChiefEngineer)",
            "retract SelfDestructArmedBy(Doctor)",
            "retract SelfDestructArmedBy(Ensign)",
            "retract SelfDestructArmedBy(FirstOfficer)"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
