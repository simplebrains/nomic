    },
    {
      "scenario": "self-destruct needs two senior officers and only the captain cancels",
      "steps": [
        {
          "description": "AuthorizeSelfDestruct(Ensign) rejected by DestructAuthority",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DestructAuthority",
            "DoAuthorize"
          ]
        },
        {
          "description": "AuthorizeSelfDestruct(Captain) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "AuthorizeSelfDestruct(Captain) rejected by DestructOnce",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DestructOnce",
            "DoAuthorize"
          ]
        },
        {
          "description": "Tick rejected by DoTick",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DoTick"
          ]
        },
        {
          "description": "AuthorizeSelfDestruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SelfDestructArmed"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "Tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "CancelSelfDestruct(FirstOfficer) rejected by CancelIsCaptains",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "CancelIsCaptains",
            "DoCancel"
          ]
        },
        {
          "description": "CancelSelfDestruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Countdown",
            "retract SelfDestructArmedBy(Captain)",
            "retract SelfDestructArmedBy(ChiefEngineer)",
            "retract SelfDestructArmedBy(Doctor)",
            "retract SelfDestructArmedBy(Ensign)",
            "retract SelfDestructArmedBy(FirstOfficer)"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
