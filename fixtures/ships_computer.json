    {
      "scenario": "detonation",
      "steps": [
        {
          "description": "AuthorizeSelfDestruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "AuthorizeSelfDestruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SelfDestructArmed"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "Tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "Tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "Tick accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "Detonation"
          ],
          "effects": [
            "assert Countdown = 0",
            "assert Destroyed"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "SetAlert(Captain, Green) rejected by AlertCommand",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "AlertCommand"
          ]
        },
        {
          "description": "Tick rejected by DoTick",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DoTick"
          ]
        }
      ],
      "final_state": [
        "AlertStatus = Green",
        "Allocation(Impulse) = 1",
        "Allocation(LifeSupport) = 2",
        "Allocation(Sensors) = 1",
        "Allocation(Shields) = 3",
        "Allocation(Torpedoes) = 1",
        "Allocation(Warp) = 4",
        "Countdown = 0",
        "Destroyed",
        "HullIntegrity = 100",
        "OnBridge(Captain)",
        "OnBridge(Ensign)",
        "OnBridge(FirstOfficer)",
        "ReactorOutput = 12",
        "SelfDestructArmedBy(Captain)",
        "SelfDestructArmedBy(FirstOfficer)",
        "TorpedoCount = 4"
      ]
    },
    {
      "scenario": "the computer goes to red alert on its own when life support fails",
