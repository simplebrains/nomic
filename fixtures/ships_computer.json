        {
          "description": "AllStop(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract WarpSpeed"
          ]
        },
        {
          "description": "AllocatePower(ChiefEngineer, Warp, 2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Allocation(Warp) = 2"
          ]
        },
        {
          "description": "EngageWarp(Captain, 2) rejected by WarpOperational",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "WarpOperational",
            "DoWarp"
          ]
        },
        {
          "description": "AllocatePower(ChiefEngineer, Warp, 5) rejected by PowerBudget",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "PowerBudget"
          ]
        },
        {
          "description": "AllocatePower(ChiefEngineer, Sensors, 0) accepted",
