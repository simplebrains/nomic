    {
      "scenario": "detonation",
      "steps": [
        {
          "description": "authorize_self_destruct(Captain) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert SelfDestructArmedBy(Captain) = true"
          ]
        },
        {
          "description": "authorize_self_destruct(FirstOfficer) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "SELF_DESTRUCT_ARMED"
          ],
          "effects": [
            "assert SelfDestructArmedBy(FirstOfficer) = true",
            "assert Countdown = 3"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 2"
          ]
        },
        {
          "description": "tick accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Countdown = 1"
          ]
        },
        {
          "description": "tick accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "DETONATION"
          ],
          "effects": [
            "assert Countdown = 0",
            "assert Destroyed"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "set_alert(Captain, Green) rejected by alert_command",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "alert_command"
          ]
        },
        {
          "description": "tick rejected by do_tick",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do_tick"
          ]
        }
      ],
