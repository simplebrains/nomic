        },
        {
          "description": "engage_warp(Captain, 2) rejected by warp_operational",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "warp_operational",
            "do_warp"
          ]
        },
        {
          "description": "allocate_power(ChiefEngineer, Warp, 5) rejected by power_budget",
