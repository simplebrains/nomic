      "final_state": [
        "Owner(0, 1) = Red",
        "Owner(0, 5) = Black",
        "Owner(0, 7) = Black",
        "Owner(1, 0) = Red",
        "Owner(1, 2) = Red",
        "Owner(1, 6) = Black",
        "Owner(2, 1) = Red",
        "Owner(2, 5) = Black",
        "Owner(2, 7) = Black",
        "Owner(3, 0) = Red",
        "Owner(3, 2) = Red",
        "Owner(3, 6) = Black",
        "Owner(4, 1) = Red",
        "Owner(4, 5) = Black",
        "Owner(4, 7) = Black",
        "Owner(5, 0) = Red",
        "Owner(5, 2) = Red",
        "Owner(5, 6) = Black",
        "Owner(6, 1) = Red",
        "Owner(6, 5) = Black",
        "Owner(6, 7) = Black",
        "Owner(7, 0) = Red",
        "Owner(7, 2) = Red",
        "Owner(7, 6) = Black",
        "Turn = Red"
