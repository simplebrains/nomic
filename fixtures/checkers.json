{
  "nomic_core": "0.1",
  "model": "Checkers",
  "cases": [
    {
      "scenario": "opening steps alternate turns",
      "steps": [
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "step(Red, 1, 2, 1, 1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Owner(1, 2)",
            "assert Owner(2, 3) = Red",
            "assert Turn = Black"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "step(Black, 4, 5, -1, -1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Owner(3, 4) = Black",
            "retract Owner(4, 5)",
            "assert Turn = Red"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "step(Red, 3, 2, 1, 1) rejected by capture_is_mandatory",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "capture_is_mandatory"
          ]
        }
      ],
      "final_state": [
        "Owner(0, 1) = Red",
        "Owner(0, 5) = Black",
        "Owner(0, 7) = Black",
        "Owner(1, 0) = Red",
        "Owner(1, 6) = Black",
        "Owner(2, 1) = Red",
        "Owner(2, 3) = Red",
        "Owner(2, 5) = Black",
        "Owner(2, 7) = Black",
        "Owner(3, 0) = Red",
        "Owner(3, 2) = Red",
        "Owner(3, 4) = Black",
        "Owner(3, 6) = Black",
        "Owner(4, 1) = Red",
        "Owner(4, 7) = Black",
        "Owner(5, 0) = Red",
        "Owner(5, 2) = Red",
        "Owner(5, 6) = Black",
        "Owner(6, 1) = Red",
        "Owner(6, 5) = Black",
        "Owner(6, 7) = Black",
        "Owner(7, 0) = Red",
        "Owner(7, 2) = Red",
        "Owner(7, 6) = Black",
        "Turn = Red"
      ]
    },
    {
      "scenario": "a single jump captures and hands over the turn",
      "steps": [
        {
          "description": "step(Red, 1, 2, 1, 1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Owner(1, 2)",
            "assert Owner(2, 3) = Red",
            "assert Turn = Black"
