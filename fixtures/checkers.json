        {
          "description": "step(Black, 4, 5, -1, -1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Owner(3, 4) = Black",
            "retract Owner(4, 5)",
            "assert Turn = Red"
          ]
        },
        {
          "description": "jump(Red, 2, 3, 1, 1) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "JUMP_ENDED(4, 5)"
          ],
          "effects": [
            "retract Continuing(2, 3)",
            "assert Continuing(4, 5) = true",
            "retract King(3, 4)",
            "retract Owner(2, 3)",
            "retract Owner(3, 4)",
            "assert Owner(4, 5) = Red",
            "retract Continuing(4, 5)",
            "retract Crowned(4, 5)",
            "assert Turn = Black"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "Owner(0, 1) = Red",
        "Owner(0, 5) = Black",
        "Owner(0, 7) = Black",
        "Owner(1, 0) = Red",
        "Owner(1, 6) = Black",
        "Owner(2, 1) = Red",
        "Owner(2, 5) = Black",
        "Owner(2, 7) = Black",
        "Owner(3, 0) = Red",
        "Owner(3, 2) = Red",
        "Owner(3, 6) = Black",
        "Owner(4, 1) = Red",
        "Owner(4, 5) = Red",
        "Owner(4, 7) = Black",
        "Owner(5, 0) = Red",
        "Owner(5, 2) = Red",
        "Owner(5, 6) = Black",
        "Owner(6, 1) = Red",
        "Owner(6, 5) = Black",
        "Owner(6, 7) = Black",
        "Owner(7, 0) = Red",
        "Owner(7, 2) = Red",
        "Owner(7, 6) = Black",
        "Turn = Black"
      ]
    },
    {
      "scenario": "men only move forward and only onto empty dark squares",
      "steps": [
        {
          "description": "step(Red, 1, 2, 1, -1) rejected by make_step",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "make_step"
          ]
        },
        {
          "description": "step(Red, 1, 2, 0, 1) rejected by make_step",
