          "description": "Unlock(Hero, Treasury) rejected by UnlockKey",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "UnlockKey",
            "DoUnlock"
          ]
        }
      ],
      "final_state": [
        "Alive(Dragon)",
        "Alive(Goblin)",
        "Alive(Hero)",
        "Alive(Orc)",
        "HP(Dragon) = 40",
        "HP(Goblin) = 6",
        "HP(Hero) = 20",
        "HP(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Potion) = Hall",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Goblin) = Hall",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Hero"
      ]
    },
    {
