          "accepted": true,
          "events": [
            "Died(Goblin)"
          ],
          "effects": [
            "assert HP(Goblin) = -1",
            "assert Turn = Goblin",
            "retract Alive(Goblin)",
            "retract Location(Goblin)",
            "assert Turn = Orc"
          ]
        },
        {
          "description": "expect",
          "passed": true
