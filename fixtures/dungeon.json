          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "attack(Hero, Dragon, 6) rejected by attack_target",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "attack_target",
            "do_attack"
          ]
        },
        {
          "description": "pickUp(Hero, Potion) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Carrying(Hero, Potion) = true",
            "retract ItemAt(Potion)",
            "assert Turn = Orc"
          ]
        }
      ],
      "final_state": [
        "Alive(Dragon)",
        "Alive(Hero)",
        "Alive(Orc)",
        "Carrying(Hero, Potion)",
        "HitPoints(Dragon) = 40",
        "HitPoints(Goblin) = -1",
        "HitPoints(Hero) = 15",
        "HitPoints(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Orc"
