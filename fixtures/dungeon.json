          ]
        },
        {
          "description": "Wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "Attack(Hero, Goblin, 1) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HP(Goblin) = 5",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Attack(Goblin, Hero, 1) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HP(Hero) = 15",
            "assert Turn = Orc"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "Wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "Attack(Hero, Goblin, 6) accepted with events",
