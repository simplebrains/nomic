            "assert Turn = Hero"
          ]
        },
        {
          "description": "attack(Hero, Goblin, 1) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HitPoints(Goblin) = 5",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "expect",
          "passed": true
