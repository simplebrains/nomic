            "AttackTurn",
            "AttackTarget",
            "DoAttack"
          ]
        },
        {
          "description": "Wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "Wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "Attack(Hero, Dragon, 6) rejected by AttackTarget",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "AttackTarget",
            "DoAttack"
          ]
        },
        {
          "description": "PickUp(Hero, Potion) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Carrying(Hero, Potion) = true",
            "retract ItemAt(Potion)",
            "assert Turn = Orc"
          ]
        }
      ],
      "final_state": [
        "Alive(Dragon)",
        "Alive(Hero)",
        "Alive(Orc)",
        "Carrying(Hero, Potion)",
        "HP(Dragon) = 40",
        "HP(Goblin) = -1",
        "HP(Hero) = 15",
        "HP(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Orc"
      ]
    },
