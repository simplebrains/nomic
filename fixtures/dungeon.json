            "assert Turn = Orc"
          ]
        },
        {
          "description": "wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "move(Hero, Treasury) rejected by move_unlocked",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "move_unlocked",
            "do_move"
          ]
