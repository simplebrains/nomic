{
  "nomic_core": "0.1",
  "model": "DungeonCrawl",
  "cases": [
    {
      "scenario": "initiative cycles through the living",
      "steps": [
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "move(Hero, Hall) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Location(Hero) = Hall",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "wait(Goblin) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Orc"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "wait(Goblin) rejected by wait_turn",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "wait_turn",
            "do_wait"
          ]
        }
      ],
      "final_state": [
        "Alive(Dragon)",
        "Alive(Goblin)",
        "Alive(Hero)",
        "Alive(Orc)",
        "HitPoints(Dragon) = 40",
        "HitPoints(Goblin) = 6",
        "HitPoints(Hero) = 20",
        "HitPoints(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Potion) = Hall",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Goblin) = Hall",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Hero"
      ]
    },
    {
      "scenario": "rooms must connect and locked doors hold",
      "steps": [
        {
          "description": "move(Hero, Lair) rejected by move_adjacent",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "move_adjacent",
            "do_move"
          ]
        },
        {
          "description": "move(Hero, Hall) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Location(Hero) = Hall",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "wait(Goblin) accepted",
