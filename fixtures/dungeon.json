        {
          "description": "wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "attack(Hero, Goblin, 6) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "DIED(Goblin)"
