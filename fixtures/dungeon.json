{
  "nomic_core": "0.1",
  "model": "DungeonCrawl",
  "cases": [
    {
      "scenario": "initiative cycles through the living",
      "steps": [
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Move(Hero, Hall) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Location(Hero) = Hall",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Wait(Goblin) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Orc"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "Wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "Wait(Goblin) rejected by WaitTurn",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "WaitTurn",
            "DoWait"
          ]
        }
      ],
      "final_state": [
        "Alive(Dragon)",
        "Alive(Goblin)",
        "Alive(Hero)",
        "Alive(Orc)",
        "HP(Dragon) = 40",
        "HP(Goblin) = 6",
        "HP(Hero) = 20",
        "HP(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Potion) = Hall",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Goblin) = Hall",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Hero"
      ]
    },
    {
      "scenario": "rooms must connect and locked doors hold",
      "steps": [
        {
          "description": "Move(Hero, Lair) rejected by MoveAdjacent",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "MoveAdjacent",
            "DoMove"
          ]
        },
        {
          "description": "Move(Hero, Hall) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Location(Hero) = Hall",
            "assert Turn = Goblin"
          ]
        },
        {
          "description": "Wait(Goblin) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Orc"
          ]
        },
        {
          "description": "Wait(Orc) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Dragon"
          ]
        },
        {
          "description": "Wait(Dragon) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Turn = Hero"
          ]
        },
        {
          "description": "Move(Hero, Treasury) rejected by MoveUnlocked",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "MoveUnlocked",
            "DoMove"
          ]
        },
