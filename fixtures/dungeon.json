        "Alive(Goblin)",
        "Alive(Hero)",
        "Alive(Orc)",
        "HitPoints(Dragon) = 40",
        "HitPoints(Goblin) = 6",
        "HitPoints(Hero) = 20",
        "HitPoints(Orc) = 12",
        "ItemAt(Gold) = Treasury",
        "ItemAt(Key) = Lair",
        "ItemAt(Potion) = Hall",
        "ItemAt(Shield) = Armory",
        "ItemAt(Sword) = Armory",
        "Location(Dragon) = Lair",
        "Location(Goblin) = Hall",
        "Location(Hero) = Hall",
        "Location(Orc) = Armory",
        "Locked(Treasury)",
        "Turn = Hero"
      ]
    },
