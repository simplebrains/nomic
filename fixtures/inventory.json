{
  "nomic_core": "0.1",
  "model": "Inventory",
  "cases": [
    {
      "scenario": "receive, order, reserve, ship",
      "steps": [
        {
          "description": "receive(StoreSouth, Gizmo, 10) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert OnHand(StoreSouth, Gizmo) = 10"
          ]
        },
        {
          "description": "place_order(1, Warehouse) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(1) = Open",
            "assert OrderSite(1) = Warehouse"
          ]
        },
        {
          "description": "add_line(1, Widget, 12) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(1, Widget) = 12"
          ]
        },
        {
          "description": "add_line(1, Gadget, 4) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(1, Gadget) = 4"
          ]
        },
        {
          "description": "reserve(1) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "LOW_STOCK(Warehouse, Gadget)"
          ],
          "effects": [
            "assert Order(1) = Reserved",
            "assert Reservation(Warehouse, Gadget) = 4",
            "assert Reservation(Warehouse, Widget) = 12"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "ship(1) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "ORDER_SHIPPED(1)"
          ],
          "effects": [
            "assert OnHand(Warehouse, Gadget) = 4",
            "assert OnHand(Warehouse, Widget) = 8",
            "assert Order(1) = Shipped",
            "assert Reservation(Warehouse, Gadget) = 0",
            "assert Reservation(Warehouse, Widget) = 0",
            "emit ORDER_SHIPPED(1)"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "ship(1) rejected by \"ship reserved\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "ship reserved",
            "do ship"
          ]
        }
      ],
      "final_state": [
        "Line(1, Gadget) = 4",
        "Line(1, Widget) = 12",
        "OnHand(StoreNorth, Widget) = 6",
        "OnHand(StoreSouth, Gizmo) = 10",
        "OnHand(Warehouse, Gadget) = 4",
        "OnHand(Warehouse, Widget) = 8",
        "Order(1) = Shipped",
        "OrderSite(1) = Warehouse",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5",
        "Reservation(Warehouse, Gadget) = 0",
        "Reservation(Warehouse, Widget) = 0"
      ]
    },
    {
      "scenario": "reservation is all or nothing",
      "steps": [
        {
          "description": "place_order(1, StoreNorth) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(1) = Open",
            "assert OrderSite(1) = StoreNorth"
          ]
        },
        {
          "description": "add_line(1, Widget, 4) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(1, Widget) = 4"
          ]
        },
        {
          "description": "add_line(1, Gadget, 1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(1, Gadget) = 1"
          ]
        },
        {
          "description": "reserve(1) rejected by \"reserve stock\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "reserve stock",
            "do reserve"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "transfer(Warehouse, StoreNorth, Gadget, 2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert OnHand(StoreNorth, Gadget) = 2",
            "assert OnHand(Warehouse, Gadget) = 6"
          ]
        },
        {
          "description": "reserve(1) accepted",
          "passed": true,
          "accepted": true,
          "events": [
            "LOW_STOCK(StoreNorth, Widget)"
          ],
          "effects": [
            "assert Order(1) = Reserved",
            "assert Reservation(StoreNorth, Gadget) = 1",
            "assert Reservation(StoreNorth, Widget) = 4"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "Line(1, Gadget) = 1",
        "Line(1, Widget) = 4",
        "OnHand(StoreNorth, Gadget) = 2",
        "OnHand(StoreNorth, Widget) = 6",
        "OnHand(Warehouse, Gadget) = 6",
        "OnHand(Warehouse, Widget) = 20",
        "Order(1) = Reserved",
        "OrderSite(1) = StoreNorth",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5",
        "Reservation(StoreNorth, Gadget) = 1",
        "Reservation(StoreNorth, Widget) = 4"
      ]
    },
    {
      "scenario": "cancelling a reserved order releases its stock",
      "steps": [
        {
          "description": "place_order(2, Warehouse) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(2) = Open",
            "assert OrderSite(2) = Warehouse"
          ]
        },
        {
          "description": "add_line(2, Widget, 20) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(2, Widget) = 20"
          ]
        },
        {
          "description": "reserve(2) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "LOW_STOCK(Warehouse, Widget)"
          ],
          "effects": [
            "assert Order(2) = Reserved",
            "assert Reservation(Warehouse, Widget) = 20"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "transfer(Warehouse, StoreSouth, Widget, 1) rejected by \"transfer available\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "transfer available",
            "do transfer"
          ]
        },
        {
          "description": "cancel(2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(2) = Cancelled",
            "assert Reservation(Warehouse, Widget) = 0"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "cancel(2) rejected by \"cancel live\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "cancel live",
            "do cancel"
          ]
        },
        {
          "description": "add_line(2, Gadget, 1) rejected by \"line on open order\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "line on open order"
          ]
        }
      ],
      "final_state": [
        "Line(2, Widget) = 20",
        "OnHand(StoreNorth, Widget) = 6",
        "OnHand(Warehouse, Gadget) = 8",
        "OnHand(Warehouse, Widget) = 20",
        "Order(2) = Cancelled",
        "OrderSite(2) = Warehouse",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5",
        "Reservation(Warehouse, Widget) = 0"
      ]
    },
    {
      "scenario": "order ids are single use and lines need an open order",
      "steps": [
        {
          "description": "place_order(3, StoreSouth) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(3) = Open",
            "assert OrderSite(3) = StoreSouth"
          ]
        },
        {
          "description": "place_order(3, Warehouse) rejected by \"order id free\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "order id free"
          ]
        },
        {
          "description": "reserve(3) rejected by \"reserve non empty\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "reserve non empty",
            "do reserve"
          ]
        },
        {
          "description": "reserve(4) rejected by \"reserve open\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "reserve open",
            "reserve non empty",
            "do reserve"
          ]
        },
        {
          "description": "transfer(Warehouse, Warehouse, Widget, 1) rejected by \"transfer sites\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "transfer sites",
            "do transfer"
          ]
        }
      ],
      "final_state": [
        "OnHand(StoreNorth, Widget) = 6",
        "OnHand(Warehouse, Gadget) = 8",
        "OnHand(Warehouse, Widget) = 20",
        "Order(3) = Open",
        "OrderSite(3) = StoreSouth",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5"
      ]
    },
    {
      "scenario": "adjustments happen under audit and may go negative until reconciled",
      "steps": [
        {
          "description": "adjust(Warehouse, Gadget, -3) rejected by \"adjust under audit\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "adjust under audit",
            "do adjust"
          ]
        },
        {
          "description": "begin_audit(Warehouse) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Auditing(Warehouse) = true"
          ]
        },
        {
          "description": "begin_audit(Warehouse) rejected by \"do begin audit\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do begin audit"
          ]
        },
        {
          "description": "adjust(Warehouse, Gadget, -10) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "LOW_STOCK(Warehouse, Gadget)"
          ],
          "effects": [
            "assert OnHand(Warehouse, Gadget) = -2"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "end_audit(Warehouse) rejected by \"end audit reconciled\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "end audit reconciled"
          ]
        },
        {
          "description": "receive(Warehouse, Gadget, 2) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "STOCK_OUT(Warehouse, Gadget)"
          ],
          "effects": [
            "assert OnHand(Warehouse, Gadget) = 0"
          ]
        },
        {
          "description": "end_audit(Warehouse) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "retract Auditing(Warehouse)"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "OnHand(StoreNorth, Widget) = 6",
        "OnHand(Warehouse, Gadget) = 0",
        "OnHand(Warehouse, Widget) = 20",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5"
      ]
    },
    {
      "scenario": "stock-out and low-stock are announced once each",
      "steps": [
        {
          "description": "place_order(1, StoreNorth) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Order(1) = Open",
            "assert OrderSite(1) = StoreNorth"
          ]
        },
        {
          "description": "add_line(1, Widget, 6) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Line(1, Widget) = 6"
          ]
        },
        {
          "description": "reserve(1) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "LOW_STOCK(StoreNorth, Widget)"
          ],
          "effects": [
            "assert Order(1) = Reserved",
            "assert Reservation(StoreNorth, Widget) = 6"
          ]
        },
        {
          "description": "ship(1) accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "ORDER_SHIPPED(1)",
            "STOCK_OUT(StoreNorth, Widget)"
          ],
          "effects": [
            "assert OnHand(StoreNorth, Widget) = 0",
            "assert Order(1) = Shipped",
            "assert Reservation(StoreNorth, Widget) = 0",
            "emit ORDER_SHIPPED(1)"
          ]
        },
        {
          "description": "receive(StoreNorth, Widget, 1) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert OnHand(StoreNorth, Widget) = 1"
          ]
        },
        {
          "description": "receive(StoreNorth, Widget, 4) accepted with events",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert OnHand(StoreNorth, Widget) = 5"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "Line(1, Widget) = 6",
        "OnHand(StoreNorth, Widget) = 5",
        "OnHand(Warehouse, Gadget) = 8",
        "OnHand(Warehouse, Widget) = 20",
        "Order(1) = Shipped",
        "OrderSite(1) = StoreNorth",
        "ReorderPoint(StoreNorth, Gadget) = 5",
        "ReorderPoint(StoreNorth, Gizmo) = 5",
        "ReorderPoint(StoreNorth, Widget) = 5",
        "ReorderPoint(StoreSouth, Gadget) = 5",
        "ReorderPoint(StoreSouth, Gizmo) = 5",
        "ReorderPoint(StoreSouth, Widget) = 5",
        "ReorderPoint(Warehouse, Gadget) = 5",
        "ReorderPoint(Warehouse, Gizmo) = 5",
        "ReorderPoint(Warehouse, Widget) = 5",
        "Reservation(StoreNorth, Widget) = 0"
      ]
    }
  ]
}
