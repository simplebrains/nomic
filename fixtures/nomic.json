          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "begin rejected by \"do begin\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "do begin"
          ]
        }
      ],
      "final_state": [
        "At = Typecheck",
        "Round = 0"
