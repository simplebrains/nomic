        },
        {
          "description": "ruleMatches(2, Deny, false) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Matched(2) = true",
            "assert Ruled(2) = Deny"
          ]
        },
        {
          "description": "ruleMatches(2, Allow, true) rejected by match_once",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "match_once"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TransitionRejected"
          ],
          "effects": [
            "assert Outcome = Rejected"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "At = Resolve",
        "HasEffects(1)",
        "Matched(1)",
        "Matched(2)",
        "Outcome = Rejected",
        "Round = 0",
        "Ruled(1) = Allow",
        "Ruled(2) = Deny"
      ]
    },
    {
      "scenario": "conflicting effects are a model error, not a resolution",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
