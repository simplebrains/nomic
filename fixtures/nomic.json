          "description": "ruleMatches(1, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
