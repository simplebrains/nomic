            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "rule_matches(2, Deny, false) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Matched(2) = true",
            "assert Ruled(2) = Deny"
          ]
        },
        {
          "description": "rule_matches(2, Allow, true) rejected by \"match once\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "match once"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TRANSITION_REJECTED"
          ],
          "effects": [
            "assert Outcome = Rejected"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "At = Resolve",
        "HasEffects(1)",
        "Matched(1)",
        "Matched(2)",
        "Outcome = Rejected",
        "Round = 0",
        "Ruled(1) = Allow",
        "Ruled(2) = Deny"
      ]
    },
    {
      "scenario": "conflicting effects are a model error, not a resolution",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Match"
          ]
        },
        {
          "description": "rule_matches(1, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "rule_matches(3, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(3) = true",
            "assert Matched(3) = true",
            "assert Ruled(3) = Allow"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Transition"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "effects_conflict accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "MODEL_DEFECT"
          ],
          "effects": [
            "assert Conflict",
            "assert Outcome = ModelError"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance rejected by \"advance not done\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "advance not done"
          ]
        }
      ],
      "final_state": [
        "At = Transition",
        "Conflict",
        "HasEffects(1)",
        "HasEffects(3)",
        "Matched(1)",
        "Matched(3)",
        "Outcome = ModelError",
        "Round = 0",
        "Ruled(1) = Allow",
        "Ruled(3) = Allow"
      ]
    },
    {
      "scenario": "reactions cascade in rounds and each event fires once",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Match"
          ]
        },
        {
          "description": "rule_matches(1, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Transition"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Applied",
            "assert At = Detect"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "event_detected(1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Pending(1) = true"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = React"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Fired(1) = true",
            "retract Pending(1)",
            "assert Round = 1"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "event_detected(1) rejected by \"once per transition\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "once per transition"
          ]
        },
        {
          "description": "event_detected(2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Pending(2) = true"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Fired(2) = true",
            "retract Pending(2)",
            "assert Round = 2"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Verify"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TRANSITION_COMMITTED"
          ],
          "effects": [
            "assert At = Commit",
            "assert Outcome = Accepted"
          ]
        }
      ],
      "final_state": [
        "Applied",
        "At = Commit",
        "Fired(1)",
        "Fired(2)",
        "HasEffects(1)",
        "Matched(1)",
        "Outcome = Accepted",
        "Round = 2",
        "Ruled(1) = Allow"
      ]
    },
