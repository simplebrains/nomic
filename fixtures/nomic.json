    {
      "scenario": "inputs are only accepted in their stage",
      "steps": [
        {
          "description": "rule_matches(1, Allow, true) rejected by \"match only during match\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "match only during match"
          ]
        },
        {
          "description": "event_detected(1) rejected by \"detect only when detecting\"",
          "passed": true,
          "accepted": false,
          "denied_by": [
