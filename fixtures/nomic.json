    {
      "scenario": "inputs are only accepted in their stage",
      "steps": [
        {
          "description": "RuleMatches(1, Allow, true) rejected by MatchOnlyDuringMatch",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "MatchOnlyDuringMatch"
          ]
        },
        {
          "description": "EventDetected(1) rejected by DetectOnlyWhenDetecting",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DetectOnlyWhenDetecting"
          ]
        },
        {
          "description": "InvariantFails(1, false) rejected by FailOnlyInVerify",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "FailOnlyInVerify"
          ]
        },
        {
          "description": "EffectsConflict rejected by ConflictOnlyInTransition",
