          "description": "ruleMatches(1, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "ruleMatches(3, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(3) = true",
            "assert Matched(3) = true",
            "assert Ruled(3) = Allow"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Transition"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "effectsConflict accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "ModelDefect"
          ],
          "effects": [
            "assert Conflict",
            "assert Outcome = ModelError"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance rejected by advance_not_done",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "advance_not_done"
          ]
        }
      ],
      "final_state": [
        "At = Transition",
        "Conflict",
        "HasEffects(1)",
        "HasEffects(3)",
        "Matched(1)",
        "Matched(3)",
        "Outcome = ModelError",
        "Round = 0",
        "Ruled(1) = Allow",
        "Ruled(3) = Allow"
      ]
    },
    {
      "scenario": "reactions cascade in rounds and each event fires once",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
