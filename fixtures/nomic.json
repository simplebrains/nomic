{
  "nomic_core": "0.1",
  "model": "NomicMachine",
  "cases": [
    {
      "scenario": "an accepted transition passes through every stage in order",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Match"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "ruleMatches(1, Allow, true) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert HasEffects(1) = true",
            "assert Matched(1) = true",
            "assert Ruled(1) = Allow"
          ]
        },
        {
          "description": "ruleMatches(2, Allow, false) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Matched(2) = true",
            "assert Ruled(2) = Allow"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Transition"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Applied",
            "assert At = Detect"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = React"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Verify"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TransitionCommitted"
          ],
          "effects": [
            "assert At = Commit",
            "assert Outcome = Accepted"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance rejected by advance_not_done",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "advance_not_done"
          ]
        }
      ],
      "final_state": [
        "Applied",
        "At = Commit",
        "HasEffects(1)",
        "Matched(1)",
        "Matched(2)",
        "Outcome = Accepted",
        "Round = 0",
        "Ruled(1) = Allow",
        "Ruled(2) = Allow"
      ]
    },
    {
      "scenario": "no matching rule rejects",
      "steps": [
        {
          "description": "begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Match"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Check"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Resolve"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TransitionRejected"
          ],
          "effects": [
            "assert Outcome = Rejected"
          ]
        },
        {
          "description": "expect",
          "passed": true
        }
      ],
      "final_state": [
        "At = Resolve",
        "Outcome = Rejected",
        "Round = 0"
      ]
    },
    {
      "scenario": "any denial rejects, whatever the other rules say",
      "steps": [
        {
          "description": "begin accepted",
