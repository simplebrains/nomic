        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Applied",
            "assert At = Detect"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "eventDetected(1) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Pending(1) = true"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = React"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Fired(1) = true",
            "retract Pending(1)",
            "assert Round = 1"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "eventDetected(1) rejected by once_per_transition",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "once_per_transition"
          ]
        },
        {
          "description": "eventDetected(2) accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Pending(2) = true"
          ]
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert Fired(2) = true",
            "retract Pending(2)",
            "assert Round = 2"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Verify"
          ]
        },
        {
          "description": "expect",
          "passed": true
        },
        {
          "description": "advance accepted with events",
          "passed": true,
          "accepted": true,
          "events": [
            "TransitionCommitted"
          ],
          "effects": [
            "assert At = Commit",
            "assert Outcome = Accepted"
          ]
        }
      ],
      "final_state": [
        "Applied",
        "At = Commit",
        "Fired(1)",
        "Fired(2)",
        "HasEffects(1)",
        "Matched(1)",
        "Outcome = Accepted",
        "Round = 2",
        "Ruled(1) = Allow"
      ]
    },
