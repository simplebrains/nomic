          "description": "Begin accepted",
          "passed": true,
          "accepted": true,
          "effects": [
            "assert At = Typecheck",
            "assert Round = 0"
          ]
        },
        {
          "description": "Begin rejected by DoBegin",
          "passed": true,
          "accepted": false,
          "denied_by": [
            "DoBegin"
          ]
        }
      ],
      "final_state": [
        "At = Typecheck",
        "Round = 0"
      ]
